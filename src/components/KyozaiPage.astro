---
// 教材の部屋（room="manabi"：児童生徒・家族向け）／支援者の部屋（room="shien"：先生・支援者向け）／QOL（room="qol"：くらしと仕事を楽にする道具）
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import Soon from './Soon.astro';
import RulesNote from './RulesNote.astro';
import { KYOZAI, KIND_LABEL, FOR_LABEL } from '../data/kyozai';
import { KYOKA } from '../data/manabi';
import { KOMARI, fmtDate } from '../data/site';
import GithubBand from './GithubBand.astro';
import AiCopyrightNote from './AiCopyrightNote.astro';
interface Props { lang?: 'ja' | 'en'; room?: 'manabi' | 'shien' | 'qol' }
const { lang = 'ja', room = 'manabi' } = Astro.props;
const ja = lang === 'ja';
const base = ja ? '' : '/en';
const learner = room === 'manabi';
const qol = room === 'qol';
const KL = KIND_LABEL[lang], FL = FOR_LABEL[lang];
const kyokaName = Object.fromEntries(KYOKA.map((k) => [k.slug, ja ? k.ja.title : k.en.title]));
const komariName = Object.fromEntries(KOMARI.map((k) => [k.slug, ja ? k.ja.title : k.en.title]));
const list = KYOZAI.filter((m) => m.for.includes(learner ? 'honnin' : qol ? 'qol' : 'sensei'))
  .sort((a, b) => Number(b.ready !== false) - Number(a.ready !== false) || b.updated.localeCompare(a.updated));
const SHOW_FILTER = list.length >= 6; // 数が増えたら絞りこみを出す
const T = ja
  ? {
      home: 'トップ', open: '開く', code: 'コードを見る', guide: '使い方', updated: '最終更新', setup: '準備が必要',
      copy: 'リンクをコピー', copied: 'コピーしました', none: '条件に合う教材はありません。', all: 'すべて', kind: '種類',
      newTab: '（新しいタブで開きます）', rules: '利用ルール',
      count: (n: number) => `${n}件`,
      title: learner ? '教材の部屋' : qol ? 'QOL' : '支援者の部屋',
      lead: learner
        ? '学ぶための教材とアプリがあります。やってみたいものを開いてみてください。'
        : qol
        ? '学校の外の毎日や、大人と支える人のくらしを整えるための道具です。気持ちを伝える、予定を見渡すなど、学ぶための教材とは別にここに並べています。'
        : '先生・支援者の方が、支援を考えたり学んだりするための道具です。児童生徒向けの教材は「教材の部屋」にあります。',
      empty: learner ? '教材はいま準備中です。できたものから、ここに並べていきます。' : 'いま準備中です。',
      more: '教材は順次追加していきます。',
      other: learner ? { label: '先生・支援者の方へ：支援者の部屋', href: `${base}/kyozai/shien/` } : { label: '学ぶための教材は：教材の部屋', href: `${base}/kyozai/` },
      adultTitle: learner ? '先生・保護者の方へ（リンクのしかた）' : 'ほかのサイトや学校からリンクするとき',
      link: [
        '各教材の「リンクをコピー」で、教材そのもののリンク（URL）をコピーできます。リンクは変えないので、授業のページやお便りに貼っておけば、いつでも最新の教材が開きます。',
        '児童生徒に使ってもらうときは、この部屋ではなく、各教材のリンクを直接配るのがおすすめです。',
        '授業や研修で使うときは、利用ルールと職場のルールに従ってください。',
      ],
    }
  : {
      home: 'Home', open: 'Open', code: 'Code', guide: 'How to use', updated: 'Last updated', setup: 'Setup needed',
      copy: 'Copy link', copied: 'Copied', none: 'No materials match.', all: 'All', kind: 'Type',
      newTab: ' (opens in a new tab)', rules: 'Terms of use',
      count: (n: number) => `${n} item${n === 1 ? '' : 's'}`,
      title: learner ? 'Materials room' : qol ? 'QOL' : "Supporters' room",
      lead: learner
        ? 'Materials and apps for learning. Open one you would like to try.'
        : qol
        ? 'Tools for everyday life outside school, for adults and the people who support them: getting your words across, seeing your week at a glance and more. They are kept here, apart from the learning materials.'
        : 'Tools for teachers and supporters to think about and learn about support. Materials for students are in the Materials room.',
      empty: learner ? 'Materials are being prepared. They will appear here as they are finished.' : 'Being prepared.',
      more: 'More materials will be added over time.',
      other: learner ? { label: "For teachers and supporters: Supporters' room", href: `${base}/kyozai/shien/` } : { label: 'Materials for learning: Materials room', href: `${base}/kyozai/` },
      adultTitle: learner ? 'For teachers and parents (how to link)' : 'Linking from other sites or schools',
      link: [
        '"Copy link" copies the address of the material itself. It will not change, so it keeps opening the latest version wherever you paste it.',
        'When students use a material, link directly to the material rather than to this room.',
        "When using materials in lessons or training, follow the terms of use and your workplace's rules.",
      ],
    };
const crumbs = learner || qol
  ? [{ label: T.home, href: `${base}/` }, { label: T.title }]
  : [{ label: T.home, href: `${base}/` }, { label: ja ? '教材の部屋' : 'Materials room', href: `${base}/kyozai/` }, { label: T.title }];
---
<Base title={T.title} lang={lang} current={qol ? 'qol' : 'kyozai'} news={!learner} description={T.lead}>
  <div class={`wrap page kyozai-page ${learner ? 'kz-learner' : 'kz-shien'}`}>
    <Crumbs lang={lang} items={crumbs} />
    <h1>{T.title}</h1>
    <p class="lead-text">{T.lead}</p>
    {!learner && <RulesNote lang={lang} ctx="shien" />}

    {SHOW_FILTER && (
      <div class="kz-filter" role="group" aria-label={ja ? '絞りこみ' : 'Filter'}>
        <div class="kz-frow"><span class="kz-flabel">{T.kind}</span>
          <button type="button" class="kz-chip" data-f="kind" data-v="" aria-pressed="true">{T.all}</button>
          {Object.entries(KL).map(([v, l]) => <button type="button" class="kz-chip" data-f="kind" data-v={v} aria-pressed="false">{l}</button>)}
        </div>
      </div>
    )}
    {SHOW_FILTER && <p class="kz-count" id="kz-count" aria-live="polite">{T.count(list.length)}</p>}

    {list.length === 0 && <p class="kz-empty">{T.empty}</p>}
    <ul class="kz-list" id="kz-list">
      {list.map((m) => {
        const L = ja ? m.ja : m.en;
        const ready = m.ready !== false;
        const tags = [...(m.kyoka ?? []).map((s) => kyokaName[s]), ...(m.komari ?? []).map((s) => komariName[s])].filter(Boolean);
        return (
          <li class={`kz-item${ready ? '' : ' kz-soon'}`} id={m.slug} data-kind={m.kind}>
            <div class="kz-meta">
              <span class="kz-kind">{KL[m.kind]}</span>
              {tags.map((t) => <span>{t}</span>)}
              {!learner && m.needsSetup && <span class="kz-setup">{T.setup}</span>}
            </div>
            <h2 class="kz-title">{L.title}</h2>
            {ready && m.url.startsWith('https://toitoitoi-lab.github.io/') && <p class="kz-ver" data-app={m.url} hidden></p>}
            <p class="kz-text">{L.text}</p>
            {L.note && <p class="kz-note">{L.note}</p>}
            {ready ? (
              <p class="kz-links">
                <a class="btn btn-solid kz-open" href={m.url} target="_blank" rel="noopener">{T.open}<span class="visually-hidden">：{L.title}{T.newTab}</span></a>
                {!learner && m.guide && <a class="inline" href={m.guide} target="_blank" rel="noopener">{T.guide}<span class="visually-hidden">{T.newTab}</span></a>}
                {!learner && m.code && <a class="inline" href={m.code} target="_blank" rel="noopener">{T.code}<span class="visually-hidden">{T.newTab}</span></a>}
                {!learner && <button type="button" class="kz-copy" data-url={m.url} data-done={T.copied}>{T.copy}<span class="visually-hidden">：{L.title}</span></button>}
              </p>
            ) : (
              <p class="kz-links"><Soon lang={lang} /></p>
            )}
            {!learner && <p class="kz-updated">{T.updated}：<time datetime={m.updated}>{fmtDate(m.updated, lang)}</time></p>}
          </li>
        );
      })}
    </ul>
    <p class="kz-none" id="kz-none" hidden>{T.none}</p>
    {list.length > 0 && <p class="kz-more">{T.more}</p>}

    {learner ? (
      <details class="kz-linkinfo kz-adult">
        <summary>{T.adultTitle}</summary>
        <ul>{T.link.map((t) => <li>{t}</li>)}</ul>
        <p><a class="inline" href={`${base}/rules/`}>{T.rules}</a></p>
        <p class="kz-copies">
          {list.filter((m) => m.ready !== false).map((m) => (
            <span><button type="button" class="kz-copy" data-url={m.url} data-done={T.copied}>{T.copy}：{ja ? m.ja.title : m.en.title}</button></span>
          ))}
        </p>
      </details>
    ) : (
      <section class="kz-linkinfo" aria-labelledby="kz-link-title">
        <h2 id="kz-link-title">{T.adultTitle}</h2>
        <ul>{T.link.map((t) => <li>{t}</li>)}</ul>
        <p><a class="inline" href={`${base}/rules/`}>{T.rules}</a></p>
      </section>
    )}
    <AiCopyrightNote lang={lang} />
    <GithubBand lang={lang} />
    <p class="kz-other"><a class="inline" href={T.other.href}>{T.other.label}</a>{qol && <>　<a class="inline" href={`${base}/kyozai/shien/`}>{ja ? '先生・支援者の方へ：支援者の部屋' : "For teachers and supporters: Supporters' room"}</a></>}</p>
  </div>
</Base>

<script is:inline>
(function () {
  // アプリのバージョンと更新日を自動で出す。
  // 各アプリの version.json（{"version","updated"}）を読む。アプリの index.html の VERSION がそれより新しければ、そちらと公開日（Last-Modified）を使う。
  var vers = document.querySelectorAll('.kz-ver'); if (!vers.length) return;
  var ja = document.documentElement.lang === 'ja';
  function cmp(a, b) { var x = String(a).split('.'), y = String(b).split('.'); for (var i = 0; i < Math.max(x.length, y.length); i++) { var d = (parseInt(x[i], 10) || 0) - (parseInt(y[i], 10) || 0); if (d) return d; } return 0; }
  function fmt(d) { var t = new Date(d); if (isNaN(t)) return ''; return ja ? t.getFullYear() + '年' + (t.getMonth() + 1) + '月' + t.getDate() + '日更新' : 'updated ' + t.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
  vers.forEach(function (el) {
    var base = el.dataset.app.replace(/[^/]*$/, '');
    var j = fetch(base + 'version.json', { cache: 'no-store' }).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; });
    var h = fetch(base, { cache: 'no-store' }).then(function (r) { if (!r.ok) return null; var lm = r.headers.get('last-modified'); return r.text().then(function (t) { var m = t.match(/(?:const|let|var)\s+(?:APP_)?VERSION\s*=\s*["']v?([0-9][0-9.]*)["']/); return m ? { version: m[1], updated: lm } : null; }); }).catch(function () { return null; });
    Promise.all([j, h]).then(function (res) {
      var v = res[0], x = res[1];
      if (x && (!v || cmp(x.version, v.version) > 0)) v = x;
      if (!v || !v.version) return;
      var d = v.updated ? fmt(v.updated) : '';
      el.textContent = 'v' + v.version + (d ? (ja ? '（' + d + '）' : ' (' + d + ')') : '');
      el.hidden = false;
    });
  });
})();
(function () {
  // リンク（URL）をコピー
  document.querySelectorAll('.kz-copy').forEach(function (b) {
    var node = b.firstChild, label = node.textContent;
    b.addEventListener('click', function () {
      var done = function () { node.textContent = b.dataset.done; setTimeout(function () { node.textContent = label; }, 2000); };
      if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.url).then(done, function () { prompt('', b.dataset.url); });
      else prompt('', b.dataset.url);
    });
  });
  // 絞りこみ（教材が増えたときだけ表示される）
  var chips = document.querySelectorAll('.kz-chip'); if (!chips.length) return;
  var state = { kind: '' };
  var items = document.querySelectorAll('.kz-item'), count = document.getElementById('kz-count'), none = document.getElementById('kz-none');
  var ja = document.documentElement.lang === 'ja';
  function apply() {
    var n = 0;
    items.forEach(function (it) { var ok = !state.kind || it.dataset.kind === state.kind; it.hidden = !ok; if (ok) n++; });
    count.textContent = ja ? n + '件' : n + (n === 1 ? ' item' : ' items');
    none.hidden = n > 0;
  }
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      state[c.dataset.f] = c.dataset.v;
      document.querySelectorAll('.kz-chip[data-f="' + c.dataset.f + '"]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === c)); });
      apply();
    });
  });
})();
</script>
