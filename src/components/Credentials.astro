---
// 運営者の教員免許（「このサイトについて」で使う）
interface Props { lang?: 'ja' | 'en' }
const { lang = 'ja' } = Astro.props;
const ja = lang === 'ja';
const base = ja ? '' : '/en';
const T = ja
  ? {
      label: '運営者がもつ教員免許',
      kyoka: '教科', kyokaLink: '教科と学び方', kyokaHref: `${base}/manabi/`,
      subjects: [
        { name: '英語', level: '中学校・高等学校' },
        { name: 'ドイツ語', level: '中学校・高等学校' },
        { name: '技術', level: '中学校' },
        { name: '情報', level: '高等学校' },
      ],
      tokushi: '特別支援学校', tokushiNote: '5つの領域すべて', tokushiLink: '困りごとから探す', tokushiHref: `${base}/#komari`,
      areas: ['知的障害', '肢体不自由', '病弱', '視覚障害', '聴覚障害'],
      close: '教科を教える目と、障害のある子どもの学びを支える目。その両方から、道具と学び方を考えています。',
      to: 'このサイトでは →',
    }
  : {
      label: "The operator's teaching licences",
      kyoka: 'Subjects', kyokaLink: 'Subjects & ways of learning', kyokaHref: `${base}/manabi/`,
      subjects: [
        { name: 'English', level: 'Junior & senior high' },
        { name: 'German', level: 'Junior & senior high' },
        { name: 'Technology', level: 'Junior high' },
        { name: 'Informatics', level: 'Senior high' },
      ],
      tokushi: 'Special needs schools', tokushiNote: 'all five areas', tokushiLink: 'Find by need', tokushiHref: `${base}/#komari`,
      areas: ['Intellectual disabilities', 'Physical disabilities', 'Health impairments', 'Visual impairments', 'Hearing impairments'],
      close: 'One eye on teaching subjects, one on supporting learners with disabilities. Tools and ways of learning are considered from both.',
      to: 'On this site →',
      sys: 'In Japan, teaching licences are issued for each school level and subject, and special needs school licences for each area of disability.',
    };
---
<section class="cred" aria-labelledby="cred-title">
  <h3 id="cred-title" class="cred-label">{T.label}</h3>
  <div class="cred-grid">
    <div class="cred-group">
      <p class="cred-head">{T.kyoka}</p>
      <ul class="cred-list">
        {T.subjects.map((s) => <li><span class="cred-name">{s.name}</span><span class="cred-level">{s.level}</span></li>)}
      </ul>
      <p class="cred-to">{T.to} <a class="inline" href={T.kyokaHref}>{T.kyokaLink}</a></p>
    </div>
    <div class="cred-group">
      <p class="cred-head">{T.tokushi}<span class="cred-note">{T.tokushiNote}</span></p>
      <ul class="cred-chips">
        {T.areas.map((a) => <li>{a}</li>)}
      </ul>
      <p class="cred-to">{T.to} <a class="inline" href={T.tokushiHref}>{T.tokushiLink}</a></p>
    </div>
  </div>
  <p class="cred-close">{T.close}</p>
  {!ja && <p class="cred-sys">{(T as any).sys}</p>}
</section>
