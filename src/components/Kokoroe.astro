---
// 支援のひと工夫。variant="tip"（トップ、困りごとを選ぶ直前に短く）／"full"（/hitokufu/）
import { KOKOROE } from '../data/message';
interface Props { lang?: 'ja' | 'en'; variant?: 'full' | 'tip' }
const { lang = 'ja', variant = 'full' } = Astro.props;
const ja = lang === 'ja';
const K = KOKOROE[lang];
const base = ja ? '' : '/en';
---
{variant === 'tip' ? (
  <aside class="kk-tip" aria-labelledby="kk-tip-title">
    <div class="kk-tip-text">
      <p class="kk-tip-label" id="kk-tip-title"><span class="kk-tip-mark" aria-hidden="true">+</span>{K.heading}</p>
      <p class="kk-tip-lead">{K.lead.split(/(?<=、)/).map((t) => <span>{t}</span>)}</p>
    </div>
    <ol class="kk-tip-list">
      {K.points.map((p, i) => <li><span class="kk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{p.short}</li>)}
    </ol>
    <button type="button" class="kk-tip-more" aria-expanded="false" aria-controls="kk-tip-body" data-open={ja ? '3つの工夫をひらく' : 'Open the three tweaks'} data-close={ja ? 'とじる' : 'Close'}>
      <span class="kk-tip-more-label">{ja ? '3つの工夫をひらく' : 'Open the three tweaks'}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
    <div class="kk-tip-body" id="kk-tip-body" hidden>
      <p class="kk-intro">{K.intro}</p>
      <ol class="kk-points">
        {K.points.map((p, i) => (
          <li>
            <span class="kk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="kk-title">{p.title}</h3>
              <p class="kk-text">{p.text}</p>
              <p class="kk-ex">{p.ex}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <script is:inline>
      (function () {
        var b = document.currentScript.parentElement.querySelector('.kk-tip-more');
        var body = document.getElementById('kk-tip-body');
        b.addEventListener('click', function () {
          var open = b.getAttribute('aria-expanded') !== 'true';
          b.setAttribute('aria-expanded', String(open));
          body.hidden = !open;
          b.querySelector('.kk-tip-more-label').textContent = open ? b.dataset.close : b.dataset.open;
        });
      })();
    </script>
  </aside>
) : (
  <div class="kokoroe">
    <p class="kk-lead">{K.lead}</p>
    <p class="kk-intro">{K.intro}</p>
    <ol class="kk-points">
      {K.points.map((p, i) => (
        <li>
          <span class="kk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="kk-title">{p.title}</h2>
            <p class="kk-text">{p.text}</p>
            <p class="kk-ex">{p.ex}</p>
          </div>
        </li>
      ))}
    </ol>
    <p><a class="btn btn-solid" href={`${base}/#komari`}>{K.back}</a></p>
  </div>
)}
