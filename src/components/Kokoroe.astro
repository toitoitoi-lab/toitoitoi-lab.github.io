---
// 支援で大切にしていること。variant="full"（このサイトについて）／"band"（トップ、短く）
import { KOKOROE } from '../data/message';
interface Props { lang?: 'ja' | 'en'; variant?: 'full' | 'band' }
const { lang = 'ja', variant = 'full' } = Astro.props;
const ja = lang === 'ja';
const K = KOKOROE[lang];
const base = ja ? '' : '/en';
---
{variant === 'full' ? (
  <section class="kokoroe" id="kokoroe" aria-labelledby="kokoroe-title">
    <p class="kk-kicker" lang="en" aria-hidden="true">{K.kicker}</p>
    <h2 id="kokoroe-title" class="kk-heading">{K.heading}</h2>
    <p class="kk-lead">{K.lead}</p>
    <ol class="kk-points">
      {K.points.map((p, i) => (
        <li>
          <span class="kk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="kk-title">{p.title}</h3>
            <p class="kk-text">{p.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
) : (
  <aside class="kk-band" aria-labelledby="kk-band-title">
    <div class="kk-band-head">
      <h3 id="kk-band-title" class="kk-band-label">{K.heading}</h3>
      <p class="kk-band-lead">{K.lead}</p>
    </div>
    <ol class="kk-band-list">
      {K.points.map((p, i) => <li><span class="kk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{p.title}</li>)}
    </ol>
    <a class="kk-band-more" href={`${base}/about/#kokoroe`}>{ja ? 'くわしく読む' : 'Read more'}<span class="visually-hidden">{ja ? '（支援で大切にしていること）' : ' (What matters in support)'}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
  </aside>
)}
