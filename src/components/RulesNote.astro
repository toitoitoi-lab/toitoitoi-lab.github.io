---
// 利用ルールを、使う直前の場所で一行だけ知らせる（野暮ったくならないよう、箱にせず細い線だけ）
interface Props { lang?: 'ja' | 'en'; ctx: 'shien' | 'print' | 'kenshu' | 'riyou' | 'apps' }
const { lang = 'ja', ctx } = Astro.props;
const ja = lang === 'ja';
const base = ja ? '' : '/en';
const C = {
  shien: { ja: ['使う前に', '実在の児童生徒の情報は入れない・載せない。仕事で使うときは、職場のルールに従う。'], en: ['Before you use', 'Do not enter or post real students’ information. At work, follow your workplace’s rules.'], at: 'summary' },
  apps: { ja: ['使う前に', 'アプリには架空のデータだけを入れます。仕事で使うときは、職場のルールに従う。'], en: ['Before you use', 'Enter only fictional data in the apps. At work, follow your workplace’s rules.'], at: 'r4' },
  print: { ja: ['配るときは', '出典（ページの上下の表示）を消さずに使ってください。'], en: ['When sharing', 'Keep the source line at the top and bottom of each page.'], at: 'r2' },
  kenshu: { ja: ['研修で使うとき', '資料や画面を研修で使う範囲は、利用ルールに沿ってご相談ください。'], en: ['For training', 'Please ask within the terms of use about using materials or screens in training.'], at: 'r8' },
  riyou: { ja: ['利用の前に', '授業・校内研修・お便りなどで使える範囲は、利用ルールで確かめられます。'], en: ['Before using', 'You can check what is allowed in lessons, school training or newsletters in the terms of use.'], at: 'summary' },
}[ctx];
const [k, text] = ja ? C.ja : C.en;
---
<p class="rn">
  <span class="rn-k">{k}</span>
  <span class="rn-t">{text}</span>
  <a class="rn-a" href={`${base}/rules/#${C.at}`}>{ja ? '利用ルール' : 'Terms of use'}<span aria-hidden="true"> →</span></a>
</p>
