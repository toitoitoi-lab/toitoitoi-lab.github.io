---
// 困りごとページの本体（日本語・英語で共通）
import Base from '../layouts/Base.astro';
import Illust from './Illust.astro';
import Soon from './Soon.astro';
import Crumbs from './Crumbs.astro';
import MethodSearch from './MethodSearch.astro';
import { KOMARI, TACHIBA, fmtDate, type Komari } from '../data/site';
import { CONTENT, CHECKED, KIND_LABEL } from '../data/methods';
import { CONTENT_EN, CHECKED_EN, KIND_LABEL_EN } from '../data/methods_en';
interface Props { k: Komari; lang?: 'ja' | 'en' }
const { k, lang = 'ja' } = Astro.props;
const ja = lang === 'ja';
const base = ja ? '' : '/en';
const c = (ja ? CONTENT : CONTENT_EN)[k.slug];
const KL = ja ? KIND_LABEL : KIND_LABEL_EN;
const L = (x: { ja: any; en: any }) => (ja ? x.ja : x.en);
const kinds = (['os', 'tool', 'env'] as const).filter((kd) => c?.methods.some((m) => m.kind === kd));
const tb = Object.fromEntries(TACHIBA.map((x) => [x.slug, x]));
const others = KOMARI.filter((o) => o.slug !== k.slug);
const T = ja
  ? { home: 'トップ', list: '困りごとから探す', review: '随時更新中', upd: '最終更新', soon: 'このページは準備中です。',
      draft: 'このページは随時更新中です。', draftText: 'ここにあるのは一般的な方法の例です。', kkLink: '支援のひと工夫', kkAfter: 'もあわせてご覧ください。「こんな方法もあるよ」「ここが分かりにくい」といった声も、ぜひお寄せください。',
      checked: `機能の名前や場所は、機種やバージョンによって違うことがあります（${CHECKED}時点）。`,
      toc: 'このページの目次', tocTitle: '方法の一覧', points: '立場ごとのポイント', fits: 'こんなときに：', links: '参考になるページ', ext: '（外部サイト）', others: 'ほかの困りごと', sep: '／' }
  : { home: 'Home', list: 'Find by need', review: 'Updating', upd: 'Last updated', soon: 'This page is being prepared.',
      draft: 'This page is updated as we go.', draftText: 'These are common examples. ', kkLink: 'Small tweaks that make support work', kkAfter: ' can help you choose. If you know another method or find something unclear, please let us know.',
      checked: `Feature names and locations can differ by device and version (checked ${CHECKED_EN}).`,
      toc: 'On this page', tocTitle: 'Methods', points: 'Points for each role', fits: 'Useful when: ', links: 'Further reading', ext: ' (external site)', others: 'Other needs', sep: ' / ' };
---
<Base title={L(k).title} lang={lang} current="komari" description={`${L(k).title}: ${L(k).examples}`}>
  <div class="wrap page komari-page">
    <Crumbs lang={lang} items={[{ label: T.home, href: `${base}/` }, { label: T.list, href: `${base}/#komari` }, { label: L(k).title }]} />
    <div class="page-head">
      <div class={`art-sm stage-${k.stage}`}><Illust shapes={k.shapes} /></div>
      <div>
        <h1>{L(k).title}</h1>
        <p class="page-status">
          {!k.ready && <Soon lang={lang} tone={k.review ? 'update' : 'soon'} label={k.review ? T.review : undefined} />}
          {k.updated && <span class="updated">{T.upd}<time datetime={k.updated}>{ja ? ' ' : ': '}{fmtDate(k.updated, lang)}</time></span>}
        </p>
      </div>
    </div>

    {!c ? (
      <div class="notice"><p><strong>{T.soon}</strong></p></div>
    ) : (
      <>
        <p class="lead-text">{c.lead}</p>
        {k.review && (
          <div class="notice">
            <p><strong>{T.draft}</strong>{T.draftText}<a class="inline" href={`${base}/hitokufu/`}>{T.kkLink}</a>{T.kkAfter}</p>
            <p>{T.checked}</p>
          </div>
        )}

        <MethodSearch slug={k.slug} lang={lang} />

        <nav class="toc" aria-label={T.toc}>
          <h2 class="toc-title">{T.tocTitle}</h2>
          <ul>
            {kinds.map((kd) => (
              <li>
                <a href={`#kind-${kd}`}>{KL[kd]}</a>
                <ul>{c.methods.filter((m) => m.kind === kd).map((m) => <li><a href={`#m-${m.id}`}>{m.title}</a></li>)}</ul>
              </li>
            ))}
            <li><a href="#points">{T.points}</a></li>
          </ul>
        </nav>

        {kinds.map((kd) => (
          <section class="kind" aria-labelledby={`kind-${kd}`}>
            <h2 id={`kind-${kd}`}>{KL[kd]}</h2>
            {c.methods.filter((m) => m.kind === kd).map((m) => (
              <article class="method" id={`m-${m.id}`} aria-labelledby={`mt-${m.id}`}>
                <h3 id={`mt-${m.id}`}>{m.title}</h3>
                <p>{m.summary}</p>
                {m.devices && (
                  <dl class="devices">
                    {m.devices.map((d) => (<div><dt>{d.name}</dt><dd>{d.how}</dd></div>))}
                  </dl>
                )}
                {m.tips && <ul class="tips">{m.tips.map((tip) => <li>{tip}</li>)}</ul>}
                <p class="fits"><span>{T.fits}</span>{m.situations.map((sid) => c.situations.find((s) => s.id === sid)?.label).filter(Boolean).join(T.sep)}</p>
              </article>
            ))}
          </section>
        ))}

        <section id="points" aria-labelledby="points-title">
          <h2 id="points-title">{T.points}</h2>
          <ul class="points">
            {(['sensei', 'honnin', 'tsukuru'] as const).map((key) => (
              <li>
                <div class={`art-xs stage-${tb[key].stage}`}><Illust shapes={tb[key].shapes} /></div>
                <div><h3>{L(tb[key]).title}</h3><p>{c.points[key]}</p></div>
              </li>
            ))}
          </ul>
        </section>

        {ja && c.links && (
          <section aria-labelledby="links-title">
            <h2 id="links-title">{T.links}</h2>
            <ul>{c.links.map((l) => <li><a class="inline" href={l.href}>{l.label}{T.ext}</a></li>)}</ul>
          </section>
        )}
      </>
    )}

    <section aria-labelledby="others-title">
      <h2 id="others-title">{T.others}</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={`${base}/komari/${o.slug}/`}><span class={`art-xs stage-${o.stage}`}><Illust shapes={o.shapes} /></span>{L(o).title}</a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
