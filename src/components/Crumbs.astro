---
interface Props { items: { label: string; href?: string }[]; lang?: 'ja' | 'en' }
const { items, lang = 'ja' } = Astro.props;
---
<nav class="breadcrumb" aria-label={lang === 'ja' ? '現在地' : 'Breadcrumb'}>
  <ol>
    {items.map((it, i) => (
      <li>{it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
