---
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import Soon from './Soon.astro';
import Illust from './Illust.astro';
import { SITEMAP_JA, SITEMAP_EN, fmtDate } from '../data/site';
interface Props { lang?: 'ja' | 'en' }
const { lang = 'ja' } = Astro.props;
const ja = lang === 'ja';
const MAP = ja ? SITEMAP_JA : SITEMAP_EN;
const total = MAP.reduce((n, g) => n + g.links.length, 0);
const icons: Record<string, string> = {
  home: 'M3 11 12 4l9 7M5 10v10h14V10M10 20v-6h4v6',
  komari: 'M9 9a3 3 0 1 1 4.5 2.6c-1 .6-1.5 1.2-1.5 2.4M12 17.5v.5M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
  tachiba: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6M17 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM15 14.5c.6-.3 1.3-.5 2-.5 2.6 0 4.5 2.2 4.5 5.5',
  hasshin: 'M3 10v4h3l6 4V6l-6 4H3zM16 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12',
};
const T = ja
  ? { title: 'サイトマップ', home: 'トップ', intro1: 'このサイトのページは、', groups: `${MAP.length}つのまとまり`, intro2: `に分かれています（全${total}ページ）。まとまりの名前の下に、その中のページが並んでいます。`,
      jump: 'まとまりへ移動', pages: (n: number) => `${n}ページ`, inside: (h: string) => `${h}の中のページ`, ext: '（外部サイト）', review: '随時更新中', upd: (d: string) => `最終更新 ${d}` }
  : { title: 'Sitemap', home: 'Home', intro1: 'Pages on this site are grouped into ', groups: `${MAP.length} sections`, intro2: ` (${total} pages in total). Each section name is followed by the pages inside it.`,
      jump: 'Jump to a section', pages: (n: number) => `${n} pages`, inside: (h: string) => `Pages in ${h}`, ext: ' (external site)', review: 'Updating', upd: (d: string) => `Last updated ${d}` };
---
<Base title={T.title} lang={lang} current="sitemap">
  <div class="wrap page sitemap-page">
    <Crumbs lang={lang} items={[{ label: T.home, href: ja ? '/' : '/en/' }, { label: T.title }]} />
    <h1>{T.title}</h1>
    <p>{T.intro1}<strong>{T.groups}</strong>{T.intro2}</p>

    <nav class="map-overview" aria-label={T.jump}>
      <ol>
        {MAP.map((g, i) => (
          <li><a href={`#${g.id}`}><span class="num" aria-hidden="true">{i + 1}</span>{g.heading}<span class="count">{T.pages(g.links.length)}</span></a></li>
        ))}
      </ol>
    </nav>

    <ol class="tree">
      {MAP.map((g, i) => (
        <li class="tree-group" id={g.id}>
          <div class="group-head">
            <span class="group-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[g.icon]}></path></svg>
            </span>
            <div>
              <h2><span class="num" aria-hidden="true">{i + 1}</span>{g.heading}</h2>
              <p class="group-desc">{g.desc}<span class="count">{ja ? `（${T.pages(g.links.length)}）` : ` (${T.pages(g.links.length)})`}</span></p>
            </div>
          </div>
          <ul class="tree-children" aria-label={T.inside(g.heading)}>
            {g.links.map((l) => (
              <li>
                <a class="child" href={l.href} lang={l.lang}>
                  {l.shapes
                    ? <span class={`thumb stage-${l.stage}`}><Illust shapes={l.shapes} /></span>
                    : <span class="thumb thumb-plain" aria-hidden="true"></span>}
                  <span class="child-text">
                    <span class="child-label">{l.label}{l.external && <span class="visually-hidden">{T.ext}</span>}</span>
                    {l.note && <span class="child-note" aria-hidden={l.external ? 'true' : undefined}>{l.note}</span>}
                  </span>
                </a>
                {!l.ready && <Soon lang={lang} tone={l.review ? 'update' : 'soon'} label={l.review ? T.review : undefined} />}
                {l.review && l.updated && <span class="updated">{T.upd(fmtDate(l.updated, lang))}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</Base>
