---
import Illust from './Illust.astro';
import Soon from './Soon.astro';
import { KOMARI, TACHIBA } from '../data/site';
import { MESSAGE } from '../data/message';
import KyokaTiles from './KyokaTiles.astro';
import KotsuList from './KotsuList.astro';
import Kokoroe from './Kokoroe.astro';
interface Props { lang: 'ja' | 'en' }
const { lang } = Astro.props;
const ja = lang === 'ja';
const base = ja ? '' : '/en';
const hrefK = (slug: string) => `${base}/komari/${slug}/`;
const hrefT = (slug: string) => `${base}/tachiba/${slug}/`;
const M = MESSAGE[lang];
const GUIDE = ja
  ? [
      { href: '#komari', title: '困りごとから探す', text: '読む・書く・伝えるなど、困っていることから方法を探します' },
      { href: '#tachiba', title: '立場から探す', text: '先生・本人や家族・つくりたい方、それぞれの入口から' },
      { href: '#manabi', title: '教科と学び方', text: '教科ごとのアプリと、学びやすくなるコツ' },
    ]
  : [
      { href: '#komari', title: 'Find by need', text: 'Start from what is hard — reading, writing, communicating' },
      { href: '#tachiba', title: 'Find by who you are', text: 'Entrances for teachers, learners and families, and builders' },
      { href: '#manabi', title: 'Subjects & learning', text: 'Apps for each subject, and tips that make learning easier' },
    ];
---
<div class="wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-main">
      {ja
        ? <p class="kicker at-def"><abbr lang="en" title="Assistive Technology">AT</abbr><span class="visually-hidden">（</span><span class="at-en" lang="en">Assistive Technology</span><span class="at-sep" aria-hidden="true">/</span><span class="visually-hidden">、</span><span class="at-ja">支援技術</span><span class="visually-hidden">）</span></p>
        : <p class="kicker at-def"><abbr title="Assistive Technology">AT</abbr><span class="visually-hidden"> (</span><span class="at-en">Assistive Technology</span><span class="visually-hidden">)</span></p>}
      {ja
        ? <h1 id="hero-title">道具ひとつで、<br />学びの<em>入口</em>は<br />ひらく。</h1>
        : <h1 id="hero-title">One tool can open<br />the <em>door</em> to learning.</h1>}
      <p class="lead">
        {ja
          ? '読む・書く・聞く・伝える。困りごとに合った道具（AT）と、その使い方を。先生にも、本人にも、家族にも届くかたちで。'
          : 'Reading, writing, listening, communicating. Tools that fit each need, and how to use them — for teachers, learners and families.'}
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={`${base}/#komari`}>{ja ? '困りごとから探す' : 'Find by need'}</a>
        <a class="btn" href="#guide">{ja ? '使い方' : 'How to use'}</a>
      </div>
    </div>
    <aside class="statement" aria-labelledby="h-statement">
      <div class="st-head">
        <span class="st-kicker" lang="en" aria-hidden="true">Statement</span>
        <h2 id="h-statement" class="st-label">{M.heading}</h2>
      </div>
      <p class="st-lead">{M.leadLines.map((l, i) => <>{i > 0 && <br class={i === 2 ? 'sp-br' : undefined} />}{l}</>)}</p>
      <p class="st-body">{M.second.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
      <p class="st-sign"><time datetime={M.date}>{M.dateLabel}</time><span aria-hidden="true">―</span><span>{M.sign}</span></p>
      <a class="st-more" href={`${base}/about/#omoi`}>{M.more}<span class="visually-hidden">{ja ? '（サイト開設にあたって）' : ' (On opening this site)'}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </aside>
  </section>

  <section class="guide" id="guide" aria-labelledby="h-guide">
    <h2 id="h-guide" class="guide-label">{ja ? 'このサイトの使い方' : 'How to use this site'}</h2>
    <ol class="guide-list">
      {GUIDE.map((g, i) => (
        <li>
          <a class="guide-item" href={g.href}>
            <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="guide-title">{g.title}</span>
            <span class="guide-text">{g.text}</span>
          </a>
        </li>
      ))}
      <li>
        <button type="button" class="guide-item guide-set" data-open-settings>
          <span class="guide-num" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></span>
          <span class="guide-title">{ja ? '見やすく変える' : 'Make it easier to see'}</span>
          <span class="guide-text">{ja ? '配色・文字の形・大きさ・行間を選べます' : 'Choose colors, letter shapes, size and spacing'}</span>
        </button>
      </li>
    </ol>
    <p class="guide-foot"><a class="inline" href={`${base}/about/`}>{ja ? 'このサイトについて（運営・大切にしていること）' : 'About this site'}</a></p>
  </section>
  <script>
    document.querySelectorAll('[data-open-settings]').forEach((b) => b.addEventListener('click', () => {
      const t = document.getElementById('settings-toggle');
      if (t && t.getAttribute('aria-expanded') !== 'true') t.click();
    }));
  </script>

  <section class="section" id="komari" aria-labelledby="h-komari">
    <div class="section-head">
      <h2 id="h-komari">{ja ? '困りごとから探す' : 'Find by need'}</h2>
      <p>{ja ? '近いものを選んでください。どのページにも「先生へ」「本人・家族へ」「つくる」の入口を用意します。' : 'Choose the one closest to you.'}</p>
    </div>
    <Kokoroe lang={lang} variant="tip" />
    <ul class="grid">
      {KOMARI.map((k) => (
        <li>
          <a class="card" href={hrefK(k.slug)}>
            <div class={`card-art stage-${k.stage}`}><Illust shapes={k.shapes} /></div>
            <div class="card-body">
              <span class="card-title-row">
                <span class="card-title">{ja ? k.ja.title : k.en.title}</span>
                {k.ready
                  ? <svg class="card-arrow" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  : <Soon lang={lang} tone={k.review ? 'update' : 'soon'} label={k.review ? (ja ? '随時更新中' : 'Updating') : undefined} />}
              </span>
              <span class="card-sub">{ja ? k.ja.examples : k.en.examples}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="tachiba" aria-labelledby="h-tachiba">
    <div class="section-head">
      <h2 id="h-tachiba">{ja ? '立場から探す' : 'Find by who you are'}</h2>
    </div>
    <ul class="grid">
      {TACHIBA.map((t) => (
        <li>
          <a class="card card-row" href={t.external ?? hrefT(t.slug)} target={t.external ? '_blank' : undefined} rel={t.external ? 'noopener' : undefined}>
            <div class={`art-sm stage-${t.stage}`}><Illust shapes={t.shapes} /></div>
            <span class={`tag up tone-${t.tagTone}`} lang="en">{t.tag}</span>
            <span class="card-title-row">
              <span class="card-title">{ja ? t.ja.title : t.en.title}</span>
              {t.external
                ? <span class="ext-ic" aria-hidden="true">↗</span>
                : !t.ready && <Soon lang={lang} tone={t.review ? 'update' : 'soon'} label={t.review ? (ja ? '随時更新中' : 'Updating') : undefined} />}
            </span>
            <span class="card-sub">{ja ? t.ja.text : t.en.text}{t.external && <span class="visually-hidden">{ja ? '（新しいタブで開きます）' : ' (opens in a new tab)'}</span>}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="manabi" aria-labelledby="h-manabi">
    <div class="section-head">
      <h2 id="h-manabi">{ja ? '教科と学び方' : 'Subjects & ways of learning'}</h2>
      <p>{ja ? '教科の勉強を助けるアプリと、知っていると学びやすくなるコツを紹介します。' : 'Apps for each subject, and small tips that make learning easier.'}</p>
    </div>
    <h3 class="sub-head">{ja ? '教科から探す' : 'Find by subject'}</h3>
    <KyokaTiles lang={lang} />
    <h3 class="sub-head">{ja ? '学び方のコツ' : 'Ways of learning'}</h3>
    <KotsuList lang={lang} limit={3} headingLevel={4} />
    <p class="section-more"><a class="btn" href={`${base}/manabi/`}>{ja ? '教科と学び方をすべて見る' : 'See all subjects and tips'}</a> <a class="btn btn-accent" href={`${base}/kyozai/`}>{ja ? '教材の部屋へ' : 'Materials room'}</a></p>
  </section>
</div>
