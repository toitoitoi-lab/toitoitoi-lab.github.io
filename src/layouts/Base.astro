---
import '@fontsource/andika/400.css';
import '@fontsource/andika/700.css';
import '@fontsource/biz-udgothic/400.css';
import '@fontsource/biz-udgothic/700.css';
import '@fontsource/klee-one/400.css';
import '@fontsource/klee-one/600.css';
import '../styles/global.css';
import { LINKS, SITE } from '../data/site';
import { TOGETHER } from '../data/message';

interface Props { title?: string; description?: string; lang?: 'ja' | 'en'; current?: string }
const { title, description, lang = 'ja', current = '' } = Astro.props;
const ja = lang === 'ja';
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${ja ? 'AT（支援技術）で学びの入口をひらく' : 'Assistive technology for learning'}`;
const desc = description ?? (ja
  ? '読む・書く・聞く・伝える。困りごとに合った道具（AT：支援技術）と、その使い方を紹介します。'
  : 'Assistive technology for reading, writing, listening and communicating.');
const home = ja ? '/' : '/en/';
const nav = ja
  ? [
      { href: '/#komari', label: '困りごと', key: 'komari' },
      { href: '/#tachiba', label: '立場', key: 'tachiba' },
      { href: '/manabi/', label: '教科と学び方', key: 'manabi' },
      { href: '/articles/', label: '記事', key: 'articles' },
      { href: '/talks/', label: '研修・講演', key: 'talks' },
      { href: '/about/', label: 'このサイトについて', key: 'about' },
    ]
  : [
      { href: '/en/#komari', label: 'Needs', key: 'komari' },
      { href: '/en/#tachiba', label: 'Who you are', key: 'tachiba' },
      { href: '/en/manabi/', label: 'Subjects', key: 'manabi' },
      { href: '/en/articles/', label: 'Articles', key: 'articles' },
      { href: '/en/talks/', label: 'Talks', key: 'talks' },
      { href: '/en/about/', label: 'About', key: 'about' },
    ];
const t = ja
  ? { skipMain: '本文へ移動', skipMap: 'サイトマップへ移動', settings: '表示設定', sitemap: 'サイトマップ', close: '表示設定を閉じる',
      theme: '配色', dark: 'ダーク', light: 'ライト', contrast: 'ハイコントラスト',
      font: '文字の形', ud: 'すっきり（UDゴシック）', kyo: '学校で習う形（教科書体）',
      size: '文字の大きさ', m: '標準', l: '大', xl: '特大', space: '文字の間隔', normal: '標準', wide: 'ひろめ',
      reset: '最初の設定にもどす', float: '操作ボタン', fRight: '右下', fLeft: '左下', fHide: 'かくす', fFree: '自由に動かす', fDock: '画面の下いっぱい（タッチ操作向け）', orient: '操作ボタンの並べ方', oRow: '横に並べる', oCol: '縦に並べる', skipBar: '操作ボタンへ移動', keyHelp: 'キーボードでは、Alt＋Shift＋M（Macは option＋shift＋M）で操作ボタンへ移動します。もう一度押すか Esc で、元の場所にもどります。', fbShown: '操作ボタンを一時的に表示しています', newTab: '（新しいタブで開きます）', fbMove: '動かす', fbMoveHelp: 'ドラッグするか、選んで矢印キーで動かせます', fbNav: 'ページの操作', fbBack: 'もどる', fbTop: '上へ', fbBottom: '下へ', fbHome: 'トップ', fbFold: 'たたむ', fbOpen: 'ひらく', fbOpenLong: '操作ボタンをひらく', saved: '設定はこのブラウザに保存され、どのページでも同じ表示になります。',
      other: 'English', otherHref: '/en/', otherLang: 'en', rules: '利用ルール',
      disclaimer: '公立学校の教員が個人の活動として運営しています。所属機関の見解を示すものではありません。' }
  : { skipMain: 'Skip to main content', skipMap: 'Skip to sitemap', settings: 'Display', sitemap: 'Sitemap', close: 'Close display settings',
      theme: 'Colors', dark: 'Dark', light: 'Light', contrast: 'High contrast',
      font: 'Letter shapes', ud: 'Clear (UD Gothic)', kyo: 'As taught at school',
      size: 'Text size', m: 'Standard', l: 'Large', xl: 'Extra large', space: 'Spacing', normal: 'Standard', wide: 'Wide',
      reset: 'Reset to defaults', float: 'Action buttons', fRight: 'Bottom right', fLeft: 'Bottom left', fHide: 'Hide', fFree: 'Move freely', fDock: 'Full width at the bottom (for touch)', orient: 'Button layout', oRow: 'In a row', oCol: 'In a column', skipBar: 'Skip to action buttons', keyHelp: 'With a keyboard, press Alt+Shift+M (option+shift+M on a Mac) to jump to the action buttons. Press it again, or Esc, to go back to where you were.', fbShown: 'Action buttons shown for now', newTab: ' (opens in a new tab)', fbMove: 'Move', fbMoveHelp: 'Drag it, or focus it and use the arrow keys', fbNav: 'Page actions', fbBack: 'Back', fbTop: 'Top of page', fbBottom: 'Bottom', fbHome: 'Home', fbFold: 'Fold', fbOpen: 'Open', fbOpenLong: 'Open action buttons', saved: 'Your choices are saved in this browser and used on every page.',
      other: '日本語', otherHref: '/', otherLang: 'ja', rules: 'Terms of use',
      disclaimer: 'Run personally by a public school teacher. Views here are not those of any employer.' };
const sitemapHref = ja ? '/sitemap/' : '/en/sitemap/';
const groups = [
  { name: 'theme', legend: t.theme, opts: [['dark', t.dark], ['light', t.light], ['contrast', t.contrast]] },
  { name: 'font', legend: t.font, opts: [['ud', t.ud], ['kyo', t.kyo]] },
  { name: 'size', legend: t.size, opts: [['m', t.m], ['l', t.l], ['xl', t.xl]] },
  { name: 'space', legend: t.space, opts: [['normal', t.normal], ['wide', t.wide]] },
  { name: 'float', legend: t.float, opts: [['right', t.fRight], ['left', t.fLeft], ['free', t.fFree], ['dock', t.fDock], ['hide', t.fHide]] },
  { name: 'orient', legend: t.orient, opts: [['row', t.oRow], ['col', t.oCol]] },
];
---
<!doctype html>
<html lang={lang} data-theme="dark" data-font="ud" data-size="m" data-space="normal" data-float="right" data-orient="row">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" hreflang="ja" href={`${SITE.url}/`} />
  <link rel="alternate" hreflang="en" href={`${SITE.url}/en/`} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      function get(k, def) { try { return localStorage.getItem('t3-' + k) || def; } catch (e) { return def; } }
      var auto = 'dark';
      try { if (matchMedia('(prefers-contrast: more)').matches || matchMedia('(forced-colors: active)').matches) auto = 'contrast'; } catch (e) {}
      d.dataset.theme = get('theme', auto);
      d.dataset.font = get('font', 'ud');
      d.dataset.size = get('size', 'm');
      d.dataset.space = get('space', 'normal');
      d.dataset.float = get('float', 'right');
      d.dataset.orient = get('orient', 'row');
      d.dataset.fold = get('fold', 'open');
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skipMain}</a>
  <a class="skip" href={sitemapHref}>{t.skipMap}</a>
  <a class="skip" href="#floatbar" id="skip-bar" aria-keyshortcuts="Alt+Shift+M">{t.skipBar}</a>
  <div class="fx" aria-hidden="true"></div>

  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={home}>
        <span class="logo-mark" aria-hidden="true">t3</span>
        <span class="logo-text" lang="en">toi toi toi</span>
      </a>
      <nav class="main-nav" aria-label={ja ? 'メイン' : 'Main'}>
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a href={t.otherHref} lang={t.otherLang} hreflang={t.otherLang}>{t.other}</a></li>
        </ul>
      </nav>
      <div class="header-tools">
        <button class="btn" type="button" id="settings-toggle" aria-expanded="false" aria-controls="settings">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
          {t.settings}
        </button>
        <a class="btn btn-accent" href={sitemapHref} aria-current={current === 'sitemap' ? 'page' : undefined}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h16"></path></svg>
          {t.sitemap}
        </a>
      </div>
    </div>

    <section class="settings" id="settings" aria-labelledby="settings-title" hidden>
      <div class="settings-head">
        <h2 id="settings-title">{t.settings}</h2>
        <button class="icon-btn" type="button" id="settings-close" aria-label={t.close}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </div>
      <form id="settings-form">
        {groups.map((g) => (
          <fieldset>
            <legend>{g.legend}</legend>
            <div class="opts">
              {g.opts.map(([v, label]) => (
                <label><input type="radio" name={g.name} value={v} /><span>{label}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        <button class="btn" type="button" id="settings-reset">{t.reset}</button>
        <p class="note">{t.saved}</p>
        <p class="note">{t.keyHelp}</p>
      </form>
    </section>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  {current !== 'contact' && (
    <aside class="together" aria-labelledby="together-title">
      <div class="wrap together-inner">
        <div>
          <h2 id="together-title">{TOGETHER[lang].heading}</h2>
          {TOGETHER[lang].body.map((p) => <p>{p}</p>)}
        </div>
        <a class="btn btn-solid" href={ja ? '/contact/' : '/en/contact/'} target="_blank" rel="noopener">{TOGETHER[lang].cta}<span class="ext-ic" aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span></a>
      </div>
    </aside>
  )}

  <footer class="site-footer" id="site-footer" tabindex="-1">
    <div class="wrap">
      <p>© <span lang="en">toi toi toi</span>　{t.disclaimer}</p>
      <ul>
        <li><a href={ja ? '/rules/' : '/en/rules/'}>{t.rules}</a></li>
        <li><a href={sitemapHref}>{t.sitemap}</a></li>
        {[['YouTube', LINKS.youtube], ['note', LINKS.note], ['GitHub', LINKS.github]].map(([name, href]) => (
          <li><a href={href} target="_blank" rel="noopener"><span lang="en">{name}</span><span class="ext-ic" aria-hidden="true">↗</span><span class="visually-hidden">{t.newTab}</span></a></li>
        ))}
      </ul>
    </div>
  </footer>

  <nav class="floatbar" id="floatbar" aria-label={t.fbNav} tabindex="-1" aria-keyshortcuts="Alt+Shift+M" data-shown={t.fbShown}>
    <button type="button" class="fb-btn fb-grip" id="fb-grip" aria-describedby="fb-grip-help">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3"></path></svg><span>{t.fbMove}</span>
    </button>
    <span class="visually-hidden" id="fb-grip-help">{t.fbMoveHelp}</span>
    <div class="fb-buttons" id="fb-buttons">
      <button type="button" class="fb-btn" id="fb-back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg><span>{t.fbBack}</span>
      </button>
      <button type="button" class="fb-btn" id="fb-top">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7"></path></svg><span>{t.fbTop}</span>
      </button>
      <button type="button" class="fb-btn" id="fb-bottom">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg><span>{t.fbBottom}</span>
      </button>
      <a class="fb-btn" href={home}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7M5 10v10h14V10"></path></svg><span>{t.fbHome}</span>
      </a>
      <button type="button" class="fb-btn" id="fb-settings" aria-controls="settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg><span>{t.settings}</span>
      </button>
    </div>
    <button type="button" class="fb-btn fb-fold" id="fb-fold" aria-expanded="true" aria-controls="fb-buttons" data-open={t.fbOpen} data-open-long={t.fbOpenLong} data-fold={t.fbFold}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="ic-open" d="M8 12h8"></path><path class="ic-folded" d="M5 7h14M5 12h14M5 17h14"></path></svg><span class="fb-fold-label">{t.fbFold}</span>
    </button>
  </nav>

  <script is:inline>
    (function () {
      var d = document.documentElement;
      var panel = document.getElementById('settings');
      var toggle = document.getElementById('settings-toggle');
      var close = document.getElementById('settings-close');
      var form = document.getElementById('settings-form');
      var defaults = { theme: 'dark', font: 'ud', size: 'm', space: 'normal', float: 'right', orient: 'row' };
      function sync() {
        ['theme', 'font', 'size', 'space', 'float', 'orient'].forEach(function (k) {
          var el = form.querySelector('input[name="' + k + '"][value="' + d.dataset[k] + '"]');
          if (el) el.checked = true;
        });
      }
      function open(show) {
        panel.hidden = !show;
        toggle.setAttribute('aria-expanded', String(show));
        if (show) { sync(); var c = form.querySelector('input:checked'); if (c) c.focus(); } else { toggle.focus(); }
      }
      toggle.addEventListener('click', function () { open(panel.hidden); });
      close.addEventListener('click', function () { open(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) open(false); });
      form.addEventListener('change', function (e) {
        var t = e.target; if (!t || !t.name) return;
        d.dataset[t.name] = t.value;
        try { localStorage.setItem('t3-' + t.name, t.value); } catch (err) {}
        if (t.name === 'float' || t.name === 'orient') applyFree();
      });
      // ── 操作ボタン（フローティング） ──
      var fold = document.getElementById('fb-fold');
      function setFold(state) {
        d.dataset.fold = state;
        var open = state !== 'folded';
        fold.setAttribute('aria-expanded', String(open));
        fold.querySelector('.fb-fold-label').textContent = open ? fold.dataset.fold : fold.dataset.open;
        if (open) fold.removeAttribute('aria-label'); else fold.setAttribute('aria-label', fold.dataset.openLong);
        try { localStorage.setItem('t3-fold', state); } catch (e) {}
      }
      setFold(d.dataset.fold === 'folded' ? 'folded' : 'open');
      fold.addEventListener('click', function () { setFold(d.dataset.fold === 'folded' ? 'open' : 'folded'); });
      document.getElementById('fb-top').addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        var logo = document.querySelector('.logo'); if (logo) logo.focus({ preventScroll: true });
      });
      document.getElementById('fb-bottom').addEventListener('click', function () {
        window.scrollTo({ top: document.documentElement.scrollHeight, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        var f = document.getElementById('site-footer'); if (f) f.focus({ preventScroll: true });
      });
      document.getElementById('fb-back').addEventListener('click', function () {
        var sameSite = document.referrer && document.referrer.indexOf(location.origin) === 0;
        if (sameSite && history.length > 1) { history.back(); return; }
        var crumbs = document.querySelectorAll('.breadcrumb a');
        location.href = crumbs.length ? crumbs[crumbs.length - 1].href : (document.documentElement.lang === 'en' ? '/en/' : '/');
      });
      document.getElementById('fb-settings').addEventListener('click', function () { open(true); });

      // ── 操作ボタンを自由に動かす（ドラッグ／矢印キー） ──
      var bar = document.getElementById('floatbar');
      var grip = document.getElementById('fb-grip');
      function clampPos(x, y) {
        var w = bar.offsetWidth, h = bar.offsetHeight;
        return [Math.min(Math.max(8, x), window.innerWidth - w - 8), Math.min(Math.max(8, y), window.innerHeight - h - 8)];
      }
      function place(x, y, save) {
        var c = clampPos(x, y);
        bar.style.left = c[0] + 'px'; bar.style.top = c[1] + 'px'; bar.style.right = 'auto'; bar.style.bottom = 'auto';
        if (save) { try { localStorage.setItem('t3-fpos', JSON.stringify({ x: c[0] / window.innerWidth, y: c[1] / window.innerHeight })); } catch (e) {} }
      }
      function clearPos() { bar.style.left = ''; bar.style.top = ''; bar.style.right = ''; bar.style.bottom = ''; }
      function applyFree() {
        if (d.dataset.float !== 'free') { clearPos(); return; }
        var p = null; try { p = JSON.parse(localStorage.getItem('t3-fpos')); } catch (e) {}
        if (p) { place(p.x * window.innerWidth, p.y * window.innerHeight, false); }
        else { var r = bar.getBoundingClientRect(); place(r.left, r.top, true); }
      }
      function goFree() {
        if (d.dataset.float === 'free') return;
        var r = bar.getBoundingClientRect();
        d.dataset.float = 'free';
        try { localStorage.setItem('t3-float', 'free'); } catch (e) {}
        place(r.left, r.top, true);
        sync();
      }
      var drag = null;
      grip.addEventListener('pointerdown', function (e) {
        if (d.dataset.float === 'dock') return;
        e.preventDefault(); goFree();
        var r = bar.getBoundingClientRect();
        drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
        grip.setPointerCapture(e.pointerId); bar.classList.add('dragging');
      });
      grip.addEventListener('pointermove', function (e) { if (drag) place(e.clientX - drag.dx, e.clientY - drag.dy, false); });
      function endDrag() {
        if (!drag) return; drag = null; bar.classList.remove('dragging');
        var r = bar.getBoundingClientRect(); place(r.left, r.top, true);
      }
      grip.addEventListener('pointerup', endDrag);
      grip.addEventListener('pointercancel', endDrag);
      grip.addEventListener('keydown', function (e) {
        var step = e.shiftKey ? 64 : 16, dx = 0, dy = 0;
        if (e.key === 'ArrowLeft') dx = -step; else if (e.key === 'ArrowRight') dx = step;
        else if (e.key === 'ArrowUp') dy = -step; else if (e.key === 'ArrowDown') dy = step; else return;
        if (d.dataset.float === 'dock') return;
        e.preventDefault(); goFree();
        var r = bar.getBoundingClientRect(); place(r.left + dx, r.top + dy, true);
      });
      window.addEventListener('resize', function () { if (d.dataset.float === 'free') applyFree(); });

      // ── キーボードで操作ボタンへ移動（Alt/option＋Shift＋M）。もう一度か Esc で元の場所へ ──
      var backTo = null;
      function firstBtn() {
        var list = bar.querySelectorAll('.fb-btn');
        for (var i = 0; i < list.length; i++) { if (list[i].offsetParent !== null) return list[i]; }
        return bar;
      }
      function toBar() {
        if (!bar.contains(document.activeElement)) backTo = document.activeElement;
        if (d.dataset.float === 'hide') { bar.classList.add('summoned'); bar.setAttribute('aria-description', bar.dataset.shown); }
        firstBtn().focus();
      }
      function leaveBar() {
        var el = backTo; backTo = null;
        if (el && el !== document.body && document.contains(el)) el.focus();
        else { var m = document.getElementById('main'); if (m) m.focus(); }
      }
      document.addEventListener('keydown', function (e) {
        if (e.altKey && e.shiftKey && !e.ctrlKey && !e.metaKey && e.code === 'KeyM') {
          e.preventDefault();
          if (bar.contains(document.activeElement)) leaveBar(); else toBar();
        } else if (e.key === 'Escape' && bar.contains(document.activeElement) && panel.hidden) {
          leaveBar();
        }
      });
      document.getElementById('skip-bar').addEventListener('click', function (e) { e.preventDefault(); toBar(); });
      bar.addEventListener('focusout', function (e) {
        if (!bar.contains(e.relatedTarget)) { bar.classList.remove('summoned'); bar.removeAttribute('aria-description'); }
      });
      applyFree();
      document.getElementById('settings-reset').addEventListener('click', function () {
        Object.keys(defaults).forEach(function (k) {
          d.dataset[k] = defaults[k];
          try { localStorage.removeItem('t3-' + k); } catch (err) {}
        });
        try { localStorage.removeItem('t3-fpos'); } catch (err) {}
        clearPos();
        sync();
      });
    })();
  </script>
</body>
</html>
