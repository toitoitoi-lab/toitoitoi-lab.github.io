---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import RulesNote from '../components/RulesNote.astro';
import { CHANNELS, AXES, SCALE_S, SCALE_C, REFRAME } from '../data/tachidomaru';
const title = '支援の前に、立ち止まる';
const desc = 'あなたの得意と、子どもに届くわかり方をスライダーで置くと、2つが重なる所（ベン図）と、合わない所をICT・AIで補う明日の手立てが出ます。診断ではありません。';
const json = JSON.stringify({ ch: CHANNELS, ax: AXES, sS: SCALE_S, sC: SCALE_C });
const QB = (who: 's' | 'c') => AXES.map((a) => ({ id: `b${who}-${a.id}`, name: a.name, l: a[who].l, r: a[who].r }));
const SL = [
  { who: 's', id: 'q-s', left: 'しんどい', right: '楽しい・得意' },
  { who: 'c', id: 'q-c', left: '負担', right: 'のってくる・届く' },
] as const;
---
<Base title={title} lang="ja" current="tachiba" description={desc}>
  <div class="wrap page prose td">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: '立場から探す', href: '/#tachiba' }, { label: title }]} />
    <p class="kk-kicker" lang="en" aria-hidden="true">Before you support</p>
    <h1>{title}</h1>
    <p class="lead-text">あなたの得意と、子どもに届くわかり方。<strong>2つが重なる所から、支援を始めます。</strong>重ならない所は、大人が子どもに合わせ、<strong>ICT・AIで補います</strong>。先生も楽しくないと、支援は続きません。所要は3分ほどです。</p>
    <ul class="td-pts">
      <li><strong>スライダーを「こんなもんかな」と置くだけです。</strong>6段階で止まります（まん中がないので、どちらかに寄せて置きます）。読み上げでは「4：どちらかといえば得意」のように、数字と言葉で伝わります。矢印キーでも動かせます。</li>
      <li><strong>診断ではありません。</strong>優劣もありません。見立てに自信がなくても、結果はそのまま明日の手立てになります。</li>
      <li><strong>名前は入れません。</strong>答えや結果は、このサイトに送られず、保存もされません。</li>
    </ul>
    <RulesNote lang="ja" ctx="check" />

    <nav class="toc" aria-label="このページの目次"><ol>
      <li><a href="#q-s">1. あなたの得意</a></li>
      <li><a href="#q-c">2. 子どもに届くわかり方</a></li>
      <li><a href="#kekka">3. 結果：重なりを見る</a></li>
      <li><a href="#q-b">さらに：関わり方のくせ（任意）</a></li>
      <li><a href="#mado">くわしく知りたいとき</a></li>
    </ol></nav>

    {SL.map((g) => (
      <section>
        <h2 id={g.id}>{g.who === 's' ? '1. あなたの得意（楽しく、自然にできる伝え方）' : '2. 子どもに届くわかり方（ふだんの様子）'}</h2>
        <p>{g.who === 's' ? '今週や最近の指導・支援を思い出しながら、ふだんの自分に近い所に置きます。「やっていて楽しいか・自然にできるか」で考えます。' : 'ふだん見ている様子から置きます。本人と一緒に置いても構いません。一人の子について、一回ずつ使います。'}</p>
        <div class="td-sls">
          {CHANNELS.map((c, i) => (
            <div class="td-sl td-un">
              <label class="td-sl-l" for={`${g.who}-${c.id}`}><span class="td-n">{i + 1}</span><strong>{g.who === 's' ? c.tsutae : c.wakari}</strong><span class="td-sl-ex">{g.who === 's' ? c.exS : c.exC}</span></label>
              <div class="td-sl-row">
                <span class="td-sl-end" aria-hidden="true">{g.left}</span>
                <input type="range" class="td-range" id={`${g.who}-${c.id}`} min="1" max="6" step="1" value="3" data-scale={g.who} aria-valuetext="未回答" />
                <div class="td-ticks" aria-hidden="true">{[1, 2, 3, 4, 5, 6].map((n) => <span>{n}</span>)}</div>
                <span class="td-sl-end" aria-hidden="true">{g.right}</span>
              </div>
              <p class="td-sl-v" aria-hidden="true">未回答</p>
            </div>
          ))}
        </div>
      </section>
    ))}

    <h2 id="kekka">3. 結果：重なりを見る</h2>
    <p class="td-acts">
      <button type="button" class="btn btn-solid" id="td-go">結果を見る</button>
      <button type="button" class="btn" id="td-reset">最初からやり直す</button>
    </p>
    <p class="note" id="td-note" aria-live="polite"></p>
    <div id="td-out"></div>
    <div class="td-keep" id="td-keep" hidden>
      <h3>結果を残す</h3>
      <p class="td-acts">
        <button type="button" class="btn" id="td-word">Word形式で保存（A4 1枚・編集できます）</button>
        <button type="button" class="btn" id="td-print">印刷する</button>
      </p>
      <p class="note">印刷した紙や、保存したファイルは、あなたの手元（端末）に残ります。実名など、子どもが誰か分かることを書き足すときは、職場の個人情報のルールに従ってください。</p>
    </div>

    <h2 id="q-b">さらに：関わり方のくせ（任意）</h2>
    <details class="td-more">
      <summary>進め方・ペース・人との距離・変化の4つも答える</summary>
      <p>どちらの端も強みであり、場面によっては弱みになります。規律の教え方や、集団への入り方を考えるときに役立ちます。<strong>ふだんの様子で近いほう</strong>を1つ選びます（どちらも違うときは飛ばして構いません）。答えたら、もう一度「結果を見る」を押してください。</p>
      <h3>あなた</h3>
      <div class="td-qs">{QB('s').map((q) => <fieldset class="td-q"><legend><span class="td-tagm">{q.name}</span>近いほうを選ぶ</legend><div class="opts td-opts td-opts-v"><label><input type="radio" name={q.id} value="l" /><span>{q.l}</span></label><label><input type="radio" name={q.id} value="r" /><span>{q.r}</span></label></div></fieldset>)}</div>
      <h3>子ども</h3>
      <div class="td-qs">{QB('c').map((q) => <fieldset class="td-q"><legend><span class="td-tagm">{q.name}</span>近いほうを選ぶ</legend><div class="opts td-opts td-opts-v"><label><input type="radio" name={q.id} value="l" /><span>{q.l}</span></label><label><input type="radio" name={q.id} value="r" /><span>{q.r}</span></label></div></fieldset>)}</div>
    </details>

    <h2 id="mado">くわしく知りたいとき</h2>
    <details class="td-det td-det-lg" data-auto>
      <summary>ベン図の見方</summary>
      <ul>
        <li><strong>重なり（まん中）</strong>：あなたも楽しく、この子にも届く伝え方です。ここから始めます。</li>
        <li><strong>この子に届くだけ（右）</strong>：あなたは得意ではないけれど、この子には届きます。大人が子どもに合わせる所です。苦手な分は、ICT・AIや道具で補います。</li>
        <li><strong>あなたの得意だけ（左）</strong>：この子には届きにくい、または負担です。やめるのではなく、形を変えて使います。</li>
        <li>スライダーは6段階です。4以上（右半分）を「得意」「届く」、2以下を「負担が大きい」として見ています。</li>
      </ul>
      <p>子どもの「わかり方」は、その子がいちばん負担少なく、情報を受け取れる形です。あなたの「伝え方」は、ふだん楽しく、自然にとっている伝える形です。</p>
    </details>
    <details class="td-det td-det-lg" data-auto>
      <summary>行動の裏側を見る（同じ行動が、強みでもあり負担でもある）</summary>
      <p>目に見える行動は、「問題」と見える前に、その子の学び方のあらわれです。</p>
      <div class="td-tbl-wrap">
        <table class="td-tbl">
          <thead><tr><th scope="col">目に見える行動</th><th scope="col">強みとして見ると</th><th scope="col">学びで苦しくなる場面</th><th scope="col">関係するわかり方</th></tr></thead>
          <tbody>{REFRAME.map((r) => <tr><th scope="row">{r.act}</th><td>{r.tsuyomi}</td><td>{r.yowami}</td><td class="td-m">{r.mado}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
    <details class="td-det td-det-lg" data-auto>
      <summary>使い方のヒント</summary>
      <ul>
        <li>AIに頼むときは、<strong>子どもの名前や、だれか分かることは入れません。</strong>「小学3年くらいの子に」のように、一般的な言い方で頼みます。</li>
        <li>重なりがないときも、心配いりません。大人が子どもに合わせ、道具で補えば、支援はつながります。得意な同僚に、やり方を見せてもらうのも近道です。</li>
        <li>手立ては1〜2週間試して、「うまくいっているサイン」が出なければ次へ進みます。子どもは変わります。学期ごと・担当が変わるたびに、置き直してください。</li>
      </ul>
    </details>
  </div>
  <script type="application/json" id="td-data" set:html={json}></script>
  <script>
    type Td = { first: string; sign: string; next: string };
    type Ch = { id: string; name: string; sub: string; wakari: string; tsutae: string; exS: string; exC: string; kS: string; kC: string; kF: string; ai: string[]; aiFirst: string; strong: { houhou: string[]; at: string[] }; weak: { houhou: string[]; at: string[] }; soudan: string; tedate: { strong: Td; weak: Td; chui: string } };
    type Adv = { ikasu: string; ki: string; soudan: string };
    type Ax = { id: string; name: string; l: string; r: string; adv: Record<string, Adv> };
    const D = JSON.parse(document.getElementById('td-data')!.textContent!) as { ch: Ch[]; ax: Ax[]; sS: string[]; sC: string[] };
    const $ = (id: string) => document.getElementById(id)!;
    const out = $('td-out'), note = $('td-note'), keep = $('td-keep');
    const h = (tag: string, cls?: string | null, text?: string | null) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const q = (l: string[]) => l.map((x) => `「${x}」`).join('');
    const detOpen = () => document.documentElement.dataset.detail === 'open';

    // ── スライダー：触るまでは「未回答」。値は6段階（1〜6・まん中なし）、読み上げは数字＋言葉。HI 以上＝得意・届く、LO 以下＝負担 ──
    const HI = 4, LO = 2;
    const ranges = Array.from(document.querySelectorAll<HTMLInputElement>('.td-range'));
    const label = (el: HTMLInputElement) => { const sc = el.dataset.scale === 's' ? D.sS : D.sC; return el.dataset.touched ? `${el.value}：${sc[Number(el.value) - 1]}` : '未回答'; };
    const paint = (el: HTMLInputElement) => { const t = label(el); el.setAttribute('aria-valuetext', t); const box = el.closest('.td-sl')!; box.querySelector('.td-sl-v')!.textContent = t; box.classList.toggle('td-un', !el.dataset.touched); };
    ranges.forEach((el) => { const touch = () => { el.dataset.touched = '1'; paint(el); }; el.addEventListener('input', touch); el.addEventListener('change', touch); el.addEventListener('pointerup', touch); paint(el); });
    const gv = (id: string): number | null => { const el = document.getElementById(id) as HTMLInputElement; return el.dataset.touched ? Number(el.value) : null; };

    type Cat = 'kasanari' | 'awaseru' | 'katachi' | 'hikaeru' | 'sonota';
    type R = { c: Ch; s: number | null; k: number | null; cat: Cat | null };
    const res = (c: Ch): R => {
      const s = gv('s-' + c.id), k = gv('c-' + c.id);
      let cat: Cat | null = null;
      if (s !== null && k !== null) cat = s >= HI && k >= HI ? 'kasanari' : k >= HI ? 'awaseru' : s >= HI ? 'katachi' : k <= LO ? 'hikaeru' : 'sonota';
      return { c, s, k, cat };
    };
    type BC = 'kasanari' | 'awaseru' | 'katachi' | 'tamesu';
    const BOX: Record<BC, { t: string; sub: string }> = {
      kasanari: { t: '重なり：ここから始める', sub: 'あなたも楽しく、この子にも届く伝え方です。' },
      awaseru: { t: '子どもに合わせる：ICT・AIで補う', sub: 'この子には届くけれど、あなたは得意ではない伝え方です。苦手な分は、道具に任せます。' },
      katachi: { t: '形を変える', sub: 'あなたの得意ですが、この子には届きにくい伝え方です。やめずに、形を変えて使います。' },
      tamesu: { t: 'まず試す：届きそうな所から', sub: 'はっきり届く所は、まだ見えていません。いちばん届きそうな所から試し、のってくる所を探します。' },
    };
    type Te = { cat: BC; c: Ch; first: string; tools: string[]; sign: string; next: string };
    const tedate = (L: R[]): Te[] => {
      const o: Te[] = [];
      L.filter((r) => r.cat === 'kasanari').forEach((r) => o.push({ cat: 'kasanari', c: r.c, first: r.c.tedate.strong.first, tools: r.c.strong.at.slice(0, 2), sign: r.c.tedate.strong.sign, next: r.c.tedate.strong.next }));
      L.filter((r) => r.cat === 'awaseru').forEach((r) => o.push({ cat: 'awaseru', c: r.c, first: r.c.aiFirst, tools: r.c.ai, sign: r.c.tedate.strong.sign, next: r.c.tedate.strong.next }));
      L.filter((r) => r.cat === 'katachi').forEach((r) => o.push({ cat: 'katachi', c: r.c, first: r.c.tedate.chui, tools: r.c.weak.at.slice(0, 2), sign: r.c.tedate.weak.sign, next: r.c.tedate.weak.next }));
      // 重なりも、届く所もないとき：いちばん届きそうな所（子どもの値が高く、あなたも使いやすい順）から試す
      if (!o.some((t) => t.cat !== 'katachi')) { const c = L.filter((r) => r.k !== null && r.k >= 3).sort((a, b) => (b.k! * 10 + (b.s ?? 0)) - (a.k! * 10 + (a.s ?? 0)))[0]; if (c) o.unshift({ cat: 'tamesu', c: c.c, first: (c.s ?? 0) >= HI ? c.c.tedate.strong.first : c.c.aiFirst, tools: (c.s ?? 0) >= HI ? c.c.strong.at.slice(0, 2) : c.c.ai, sign: c.c.tedate.strong.sign, next: c.c.tedate.strong.next }); }
      return o;
    };
    const summary = (L: R[]) => {
      const n = (f: (r: R) => boolean) => L.filter(f).map((r) => r.c.name);
      const ka = n((r) => r.cat === 'kasanari'), aw = n((r) => r.cat === 'awaseru'), kt = n((r) => r.cat === 'katachi'), hk = n((r) => r.cat === 'hikaeru');
      const kS = n((r) => (r.k ?? 0) >= HI);
      const o: string[] = [];
      if (ka.length) o.push(`重なりは${q(ka)}。ここから始めます。あなたも楽しく、この子にも届きます。`);
      else if (kS.length) o.push(`重なりは、まだありません。この子に届く${q(kS)}に、大人が合わせます。`);
      else o.push(`この子に届くわかり方が、まだはっきりしません。いちばん届きそうな所から試し、のってくる所を探します。`);
      if (aw.length) o.push(`${q(aw)}は、この子に届くけれど、あなたは得意ではありません。ICT・AIで補います。`);
      if (kt.length) o.push(`あなたの得意な${q(kt)}は、この子には届きにくい伝え方です。形を変えて使います。`);
      if (hk.length) o.push(`${q(hk)}は、この子の負担になりやすいので、控えめにします。`);
      return o;
    };

    // ── ベン図（SVG）。左＝あなたの得意だけ、まん中＝重なり、右＝この子に届くだけ ──
    type Z = { left: string[]; mid: string[]; right: string[] };
    // 図の中は短い名前（話す・伝える→話す）。読み上げ（aria-label）も同じ名前
    const sn = (r: R) => r.c.name.split('・')[0];
    const zones = (L: R[]): Z => ({
      left: L.filter((r) => (r.s ?? 0) >= HI && !((r.k ?? 0) >= HI)).map(sn),
      mid: L.filter((r) => (r.s ?? 0) >= HI && (r.k ?? 0) >= HI).map(sn),
      right: L.filter((r) => (r.k ?? 0) >= HI && !((r.s ?? 0) >= HI)).map(sn),
    });
    const vennAlt = (z: Z) => `ベン図。重なり：${z.mid.join('、') || 'なし'}。あなたの得意だけ：${z.left.join('、') || 'なし'}。この子に届くだけ：${z.right.join('、') || 'なし'}。`;
    function vennSvg(z: Z) {
      const NS = 'http://www.w3.org/2000/svg', W = 640, H = 330;
      const s = document.createElementNS(NS, 'svg'); s.setAttribute('viewBox', `0 0 ${W} ${H}`); s.setAttribute('class', 'td-venn-svg'); s.setAttribute('aria-hidden', 'true');
      const el = (tag: string, a: Record<string, string | number>, text?: string) => { const e = document.createElementNS(NS, tag); Object.entries(a).forEach(([k, v]) => e.setAttribute(k, String(v))); if (text) e.textContent = text; s.appendChild(e); return e; };
      el('circle', { cx: 245, cy: 180, r: 140, class: 'td-vc td-vc-s' });
      el('circle', { cx: 395, cy: 180, r: 140, class: 'td-vc td-vc-c' });
      el('text', { x: 150, y: 28, class: 'td-vt', 'text-anchor': 'middle' }, 'あなたの得意');
      el('text', { x: 490, y: 28, class: 'td-vt', 'text-anchor': 'middle' }, 'この子に届く');
      el('text', { x: 320, y: 325, class: 'td-vk', 'text-anchor': 'middle' }, '↑ 重なり');
      const col = (x: number, items: string[], cls: string) => { const top = 180 - ((items.length - 1) * 30) / 2 + 8; items.forEach((t, i) => el('text', { x, y: top + i * 30, class: cls, 'text-anchor': 'middle' }, t)); if (!items.length) el('text', { x, y: 186, class: 'td-vn', 'text-anchor': 'middle' }, '—'); };
      col(168, z.left, 'td-vi'); col(320, z.mid, 'td-vi td-vi-m'); col(472, z.right, 'td-vi');
      return s;
    }

    // ── 関わり方のくせ（2択） ──
    type AxRes = { a: Ax; s: 'l' | 'r' | null; c: 'l' | 'r' | null; st: string; adv: Adv | null; partial: string };
    function axResult(a: Ax): AxRes | null {
      const pick = (who: string) => { const e = document.querySelector<HTMLInputElement>(`input[name="b${who}-${a.id}"]:checked`); return e ? (e.value as 'l' | 'r') : null; };
      const s = pick('s'), c = pick('c'); if (!s && !c) return null;
      const st = s && c ? (s === c ? '重なり' : 'ずれ') : '';
      const key = s && c ? s + c : s ? s + s : c ? c + c : null;
      const partial = key && (!s || !c) ? `${s ? '子ども' : 'あなた'}は、この軸では答えていません。答えたほうに合わせた文です。` : '';
      return { a, s, c, st, adv: key ? a.adv[key] : null, partial };
    }
    function renderAx(r: AxRes) {
      const a = r.a, box = h('section', 'td-r'); const head = h('div', 'td-rh'); head.appendChild(h('h4', null, a.name)); if (r.st) head.appendChild(h('span', 'td-tag ' + (r.st === 'ずれ' ? 'td-tag-zure' : 'td-tag-sonota'), r.st)); box.appendChild(head);
      const d = (x: 'l' | 'r' | null, who: string) => who + '：' + (x === null ? '未回答' : (x === 'l' ? a.l : a.r) + '寄り');
      box.appendChild(h('p', 'td-st', `${d(r.s, 'あなた')}。${d(r.c, '子ども')}。`));
      if (r.adv) { if (r.partial) box.appendChild(h('p', 'note', r.partial)); const dl = h('dl', 'td-adv'); ([['強みを生かすと', r.adv.ikasu], ['気をつけたいこと', r.adv.ki]] as const).forEach(([k, v]) => { dl.appendChild(h('dt', null, k)); dl.appendChild(h('dd', null, v)); }); box.appendChild(dl); }
      return box;
    }

    let last: { L: R[]; sum: string[]; te: Te[]; z: Z; ax: AxRes[]; words: { s: string[]; c: string[]; f: string[] } } | null = null;

    $('td-go').addEventListener('click', () => {
      out.innerHTML = '';
      const L = D.ch.map(res);
      if (!L.some((r) => r.s !== null || r.k !== null)) { note.textContent = 'まだスライダーを置いていません。「1. あなたの得意」から置いてください。'; last = null; keep.hidden = true; return; }
      note.textContent = L.some((r) => r.s === null || r.k === null) ? '置いていないスライダーがあります。置いた分だけで表示しています。' : '';
      const sum = summary(L), te = tedate(L), z = zones(L), ax = D.ax.map(axResult).filter(Boolean) as AxRes[];
      const words = { s: L.filter((r) => (r.s ?? 0) >= HI).map((r) => r.c.kS), c: L.filter((r) => (r.k ?? 0) >= HI).map((r) => r.c.kC), f: L.filter((r) => r.k !== null && r.k <= LO).map((r) => r.c.kF) };
      last = { L, sum, te, z, ax, words };

      // 結論
      const sb = h('div', 'td-sum'); const sh = h('h3', null, '結論'); sh.id = 'td-sum-h'; sh.tabIndex = -1; sb.appendChild(sh); const ul = h('ul'); sum.forEach((x) => ul.appendChild(h('li', null, x))); sb.appendChild(ul); out.appendChild(sb);
      // ベン図
      const fig = h('figure', 'td-venn'); fig.setAttribute('role', 'img'); fig.setAttribute('aria-label', vennAlt(z)); fig.appendChild(vennSvg(z)); out.appendChild(fig);
      // 3つの箱（明日の一手）
      (['tamesu', 'kasanari', 'awaseru', 'katachi'] as const).forEach((cat) => {
        const items = te.filter((t) => t.cat === cat); if (!items.length) return;
        const sec = h('section', 'td-box td-box-' + cat); const id = 'td-box-' + cat; sec.setAttribute('aria-labelledby', id);
        const t = h('h3', null, BOX[cat].t); t.id = id; sec.append(t, h('p', 'td-box-sub', BOX[cat].sub));
        items.forEach((it) => {
          const art = h('div', 'td-box-i'); art.appendChild(h('p', 'td-box-n', `${it.c.name}（あなた：${it.c.tsutae}／この子：${it.c.wakari}）`));
          const p = h('p', 'td-te-first'); p.append(h('span', 'td-te-k', '明日の一手'), document.createTextNode(it.first)); art.appendChild(p);
          art.appendChild(h('p', 'td-at', (cat === 'awaseru' ? 'ICT・AIの例：' : '道具の例：') + it.tools.join('／')));
          const d = h('details', 'td-det') as HTMLDetailsElement; d.setAttribute('data-auto', ''); d.open = detOpen(); d.appendChild(h('summary', null, 'うまくいっているサイン・次に試すこと'));
          const dl = h('dl', 'td-adv'); dl.append(h('dt', null, 'うまくいっているサイン'), h('dd', null, it.sign), h('dt', null, '次に試すこと'), h('dd', null, it.next)); d.appendChild(dl); art.appendChild(d);
          sec.appendChild(art);
        });
        out.appendChild(sec);
      });
      // 強みのことば（客観的な言いかえ）
      if (words.s.length || words.c.length || words.f.length) {
        const sec = h('section', 'td-words'); sec.setAttribute('aria-labelledby', 'td-words-h');
        const t = h('h3', null, '強みのことば'); t.id = 'td-words-h'; sec.appendChild(t);
        sec.appendChild(h('p', 'note', '置いたスライダーを、行動の言葉に言いかえました。個別の指導計画や引き継ぎに、そのまま使えます（名前は入れずに）。'));
        const blk = (head: string, l: string[]) => { if (!l.length) return; sec.appendChild(h('h4', null, head)); const u = h('ul'); l.forEach((x) => u.appendChild(h('li', null, x))); sec.appendChild(u); };
        blk('あなたの強み', words.s); blk('この子の強み', words.c); blk('この子の負担になりやすいこと', words.f);
        const cp = h('button', 'btn', 'ことばをコピー') as HTMLButtonElement; cp.type = 'button';
        cp.addEventListener('click', async () => { const txt = [words.s.length ? '【支援する人の強み】\n' + words.s.join('\n') : '', words.c.length ? '【子どもの強み】\n' + words.c.join('\n') : '', words.f.length ? '【負担になりやすいこと】\n' + words.f.join('\n') : ''].filter(Boolean).join('\n\n'); try { await navigator.clipboard.writeText(txt); note.textContent = 'ことばをコピーしました。'; } catch { note.textContent = 'コピーできませんでした。文字を選んでコピーしてください。'; } });
        const pa = h('p', 'td-acts'); pa.appendChild(cp); sec.appendChild(pa);
        out.appendChild(sec);
      }
      if (ax.length) { out.appendChild(h('h3', 'td-sec', '関わり方のくせ')); ax.forEach((r) => out.appendChild(renderAx(r))); }
      keep.hidden = false;
      $('kekka').scrollIntoView({ block: 'start' });
      (document.getElementById('td-sum-h') as HTMLElement).focus({ preventScroll: true });
    });
    $('td-print').addEventListener('click', () => window.print());
    $('td-reset').addEventListener('click', () => {
      ranges.forEach((el) => { delete el.dataset.touched; el.value = '3'; paint(el); });
      document.querySelectorAll<HTMLInputElement>('.td input[type=radio]').forEach((i) => (i.checked = false));
      out.innerHTML = ''; note.textContent = ''; last = null; keep.hidden = true; $('q-s').scrollIntoView();
    });

    // ── Word（.docx・A4 1枚）。この端末の中で作って保存する（サイトには送らない） ──
    function vennPng(z: Z): { png: Promise<Uint8Array>; w: number; h: number } {
      const S = 2, W = 520, H = 250; const cv = document.createElement('canvas'); cv.width = W * S; cv.height = H * S; const x = cv.getContext('2d')!; x.scale(S, S);
      const F = (sz: number, b = false) => `${b ? '700 ' : ''}${sz}px "BIZ UDPGothic", "BIZ UDPゴシック", "Hiragino Sans", "Noto Sans JP", sans-serif`;
      x.fillStyle = '#fff'; x.fillRect(0, 0, W, H);
      const C = (cx: number, dash: boolean) => { x.beginPath(); x.arc(cx, 138, 105, 0, Math.PI * 2); x.fillStyle = 'rgba(74,51,176,.10)'; x.fill(); x.setLineDash(dash ? [7, 5] : []); x.strokeStyle = '#4A33B0'; x.lineWidth = 2.5; x.stroke(); x.setLineDash([]); };
      C(205, false); C(315, true);
      x.textAlign = 'center'; x.fillStyle = '#111'; x.font = F(15, true); x.fillText('あなたの得意', 130, 22); x.fillText('この子に届く', 390, 22);
      x.font = F(12, true); x.fillStyle = '#4A33B0'; x.fillText('↑ 重なり', 260, 246);
      const col = (cx: number, items: string[], bold: boolean) => { const top = 138 - ((Math.max(items.length, 1) - 1) * 21) / 2 + 5; x.font = F(14, bold); x.fillStyle = '#111'; (items.length ? items : ['—']).forEach((t, i) => x.fillText(t, cx, top + i * 21)); };
      col(145, z.left, false); col(260, z.mid, true); col(375, z.right, false);
      const png = new Promise<Uint8Array>((ok) => cv.toBlob((b) => b!.arrayBuffer().then((ab) => ok(new Uint8Array(ab))), 'image/png'));
      return { png, w: W, h: H };
    }
    $('td-word').addEventListener('click', async () => {
      if (!last) return;
      note.textContent = 'ファイルを作っています…';
      try {
        const X = await import('docx');
        const { Document, Packer, Paragraph, TextRun, HeadingLevel, Header, Footer, AlignmentType, PageNumber, BorderStyle, Table, TableRow, TableCell, WidthType, ShadingType, ImageRun, VerticalAlign } = X;
        const FONT = 'BIZ UDPゴシック', size = 18;
        const now = new Date(), pad = (n: number) => String(n).padStart(2, '0');
        const dl = `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`, file = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}`;
        const run = (text: string, o: Record<string, unknown> = {}) => new TextRun({ text, font: FONT, size, ...o });
        const para = (text: string, o: Record<string, unknown> = {}) => new Paragraph({ spacing: { after: 30, line: 250 }, children: [run(text)], ...o });
        const hd = (text: string, big = false) => new Paragraph({ heading: big ? HeadingLevel.HEADING_1 : HeadingLevel.HEADING_2, spacing: { before: big ? 0 : 110, after: 30 }, children: [new TextRun({ text, font: FONT, bold: true, size: big ? 28 : 21 })] });
        const dot = (t: string) => new Paragraph({ spacing: { after: 0, line: 240 }, indent: { left: 180, hanging: 180 }, children: [run('・' + t)] });
        const bd = { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB' }, B = { top: bd, bottom: bd, left: bd, right: bd };
        const cell = (t: string, w: number, head = false) => new TableCell({ width: { size: w, type: WidthType.DXA }, borders: B, verticalAlign: VerticalAlign.TOP, margins: { top: 30, bottom: 30, left: 70, right: 70 }, shading: head ? { type: ShadingType.CLEAR, fill: 'F0F0F0', color: 'auto' } : undefined, children: [new Paragraph({ spacing: { after: 0, line: 228 }, children: [run(t, { bold: head })] })] });
        const KIND: Record<string, string> = { kasanari: '重なり：始める', awaseru: '合わせる：ICT・AI', katachi: '形を変える', tamesu: 'まず試す' };
        const te = last.te.slice(0, 5), more = last.te.length > 5 ? `（${last.te.length}つのうち5つ。残りはサイトの結果ページで）` : '';
        const W = [1700, 1200, 4700, 2600];
        const body: any[] = [
          hd('支援の前に、立ち止まる', true),
          para(`記入日：${dl}　　記入した人：　　　　　　　子どもの呼び名：　　　　　　（名前など、だれか分かることを書き足すと個人情報になります。職場のルールに従ってください）`),
          hd('結論'), ...last.sum.map(dot),
        ];
        const g = vennPng(last.z);
        body.push(new Paragraph({ alignment: AlignmentType.CENTER, spacing: { before: 60, after: 0 }, children: [new ImageRun({ type: 'png', data: await g.png, transformation: { width: Math.round(g.w * 0.78), height: Math.round(g.h * 0.78) }, altText: { name: 'ベン図', title: 'あなたの得意とこの子に届くわかり方の重なり', description: vennAlt(last.z) } })] }));
        if (te.length) body.push(hd(`明日の一手${more}`), new Table({ width: { size: W.reduce((a, b) => a + b, 0), type: WidthType.DXA }, columnWidths: W, rows: [
          new TableRow({ tableHeader: true, children: ['区分', 'わかり方', 'まずやること', '道具・ICT・AIの例'].map((t, i) => cell(t, W[i], true)) }),
          ...te.map((t) => new TableRow({ cantSplit: true, children: [cell(KIND[t.cat], W[0]), cell(t.c.name, W[1]), cell(t.first, W[2]), cell(t.tools.slice(0, 2).join('／'), W[3])] })),
        ] }));
        const w = last.words;
        if (w.s.length || w.c.length || w.f.length) { body.push(hd('強みのことば')); if (w.s.length) body.push(para('あなたの強み：' + w.s.join('。') + '。')); if (w.c.length) body.push(para('この子の強み：' + w.c.join('。') + '。')); if (w.f.length) body.push(para('負担になりやすいこと：' + w.f.join('。') + '。')); }
        if (last.ax.length) { body.push(hd('関わり方のくせ')); last.ax.forEach((r) => { if (r.adv) body.push(dot(`${r.a.name}${r.st ? '（' + r.st + '）' : ''}：${r.adv.ki}`)); }); }
        body.push(para('AIに頼むときは、子どもの名前や、だれか分かることは入れません。', { spacing: { before: 80, after: 0 } }));
        const small = (text: string) => new TextRun({ text, font: FONT, size: 15, color: '555555' });
        const doc = new Document({
          creator: 'toi toi toi', title: 'toi toi toi｜支援の前に、立ち止まる',
          sections: [{
            properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 760, bottom: 760, left: 850, right: 850, header: 360, footer: 360 } } },
            headers: { default: new Header({ children: [new Paragraph({ border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, children: [small(`toi toi toi｜支援の前に、立ち止まる　　出力：${dl}　　診断ではありません`)] })] }) },
            footers: { default: new Footer({ children: [new Paragraph({ border: { top: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, tabStops: [{ type: 'right', position: 10200 }], children: [small('出典：toi toi toi https://toitoitoi-lab.github.io/tachidomaru/　© toi toi toi（圓井健史）'), new TextRun({ children: ['\t', PageNumber.CURRENT, ' / ', PageNumber.TOTAL_PAGES], font: FONT, size: 15, color: '555555' })] })] }) },
            children: body,
          }],
        });
        const blob = await Packer.toBlob(doc);
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `toitoitoi_tachidomaru_${file}.docx`; a.style.display = 'none';
        document.body.appendChild(a); a.click(); setTimeout(() => { a.remove(); URL.revokeObjectURL(a.href); }, 30000);
        note.textContent = 'Word形式のファイルを保存しました。';
      } catch (e) { console.error(e); note.textContent = 'ファイルを作れませんでした。印刷（PDFとして保存）をお使いください。'; }
    });
  </script>
