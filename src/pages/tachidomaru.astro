            body.push(tbl([1500, 2500, 6200], ['軸', '左の端 ／ 右の端', '気をつけたいこと'], L.ax.map((r) => [r.a.name, `${r.a.l} ／ ${r.a.r}`, r.adv ? r.adv.ki : '—'])));
          }
          body.push(new Paragraph({ spacing: { before: 60, after: 0 }, children: [run('この表は要点です。すべての方法と説明は、サイトの結果ページで読めます。', { size: size - 2, color: '555555' })] }));
          body.push(hd('やってみること', HeadingLevel.HEADING_2), ...lines(3), hd('相談する人・相談したいこと', HeadingLevel.HEADING_2), ...lines(2));
        } else {
          // 文字で短く（読み上げ向け）：結論 → 手立て → 相談先。関係のないわかり方は出さない
          const rel = L.ch.filter((r) => r.cStrong || r.cWeak || r.rel === 'chui');
          body.push(...head1, para(`診断ではありません。結論、明日からの手立て${L.te.length}つ、相談先の順に書いてあります。`));
          body.push(hd('結論', HeadingLevel.HEADING_2), ...L.sum.map(bullet));
          if (L.te.length) {
            body.push(hd(`明日からの手立て（${L.te.length}つ）${more}`, HeadingLevel.HEADING_2), para('まず1つ、1〜2週間試します。'));
            L.te.forEach((t, i) => { body.push(hd(`${i + 1}. ${t.win}：${t.kind}`, HeadingLevel.HEADING_3), para(t.first), para('うまくいっているサイン：' + t.sign), para('効かなければ：' + t.next)); });
          }
          const sd = rel.filter((r) => r.rel === 'zure' || r.rel === 'ryouhou' || r.rel === 'chui');
          if (sd.length) body.push(hd('相談先', HeadingLevel.HEADING_2), ...sd.map((r) => bullet(`${r.c.name}：${r.c.soudan}`)));
          if (L.ax.length) {
            body.push(hd('関わり方のくせ', HeadingLevel.HEADING_2));
            L.ax.forEach((r) => { if (r.adv) body.push(bullet(`${r.a.name}${r.st ? '（' + r.st + '）' : ''}：${r.adv.ki}`)); });
          }
          if (!(L.te.length >= 5 && L.ax.length)) body.push(hd('やってみること（自由に書く）', HeadingLevel.HEADING_2), ...lines(3)); // 内容が多いときは、2枚に収めるため書き込み欄を省く
        }
        const SRC = 'https://toitoitoi-lab.github.io/tachidomaru/';
        const doc = new Document({
          creator: 'toi toi toi', title: 'toi toi toi｜支援の前に、立ち止まる',
          numbering: { config: [{ reference: 'b', levels: [{ level: 0, format: LevelFormat.BULLET, text: '・', alignment: AlignmentType.LEFT, style: { paragraph: { indent: { left: 420, hanging: 280 } } } }] }] },
          sections: [{
            properties: { page: { size: { width: 11906, height: 16838 }, margin: zu ? { top: 850, bottom: 850, left: 850, right: 850, header: 400, footer: 400 } : { top: 1150, bottom: 1100, left: 1150, right: 1150, header: 500, footer: 500 } } },
            headers: { default: new Header({ children: [new Paragraph({ border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, children: [small(`toi toi toi｜支援の前に、立ち止まる　　出力：${label}　　診断ではありません`)] })] }) },
            footers: { default: new Footer({ children: [
              new Paragraph({ border: { top: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, tabStops: [{ type: 'right', position: zu ? 10200 : 9500 }], children: [small(`出典：toi toi toi ${SRC}　© toi toi toi（圓井健史）　利用ルール：https://toitoitoi-lab.github.io/rules/`), new TextRun({ children: ['\t', PageNumber.CURRENT, ' / ', PageNumber.TOTAL_PAGES], font: FONT, size: 16, color: '555555' })] }),
            ] }) },
            children: body,
          }],
        });
        const blob = await Packer.toBlob(doc);
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `toitoitoi_tachidomaru_${zu ? 'zu' : 'moji'}_${file}.docx`; a.style.display = 'none';
        document.body.appendChild(a); a.click(); setTimeout(() => { a.remove(); URL.revokeObjectURL(a.href); }, 30000);
        note.textContent = zu ? 'Word形式（図と表）のファイルを保存しました。' : 'Word形式（文字で短く）のファイルを保存しました。';
      } catch (e) { console.error(e); note.textContent = 'ファイルを作れませんでした。印刷（PDFとして保存）をお使いください。'; }
    });

    // ── 観察シート（同僚用・A4 1枚）。サイトには送らない。名前の欄はない ──
    $('td-obs').addEventListener('click', async () => {
      note.textContent = '観察シートを作っています…';
      try {
        const X = await import('docx');
        const { Document, Packer, Paragraph, TextRun, HeadingLevel, Header, Footer, BorderStyle, Table, TableRow, TableCell, WidthType, ShadingType, VerticalAlign } = X;
        const FONT = 'BIZ UDPゴシック', size = 19;
        const now = new Date(), pad = (n: number) => String(n).padStart(2, '0');
        const file = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}`;
        const run = (text: string, o: Record<string, unknown> = {}) => new TextRun({ text, font: FONT, size, ...o });
        const para = (text: string, o: Record<string, unknown> = {}) => new Paragraph({ spacing: { after: 60, line: 270 }, children: [run(text)], ...o });
        const hd = (text: string, lv: any) => new Paragraph({ heading: lv, spacing: { before: 160, after: 60 }, children: [new TextRun({ text, font: FONT, bold: true, size: lv === HeadingLevel.HEADING_1 ? 32 : 24 })] });
        const bd = { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB' }, B = { top: bd, bottom: bd, left: bd, right: bd };
        const cell = (text: string, w: number, head = false) => new TableCell({ width: { size: w, type: WidthType.DXA }, borders: B, verticalAlign: VerticalAlign.CENTER, margins: { top: 60, bottom: 60, left: 80, right: 80 }, shading: head ? { type: ShadingType.CLEAR, fill: 'F0F0F0', color: 'auto' } : undefined, children: [new Paragraph({ spacing: { after: 0, line: 260 }, children: [run(text, { bold: head })] })] });
        const W = [5600, 2400, 2200];
        const table = new Table({ width: { size: 10200, type: WidthType.DXA }, columnWidths: W, rows: [
          new TableRow({ tableHeader: true, children: ['この授業・活動で見られたこと（実際にしたこと）', '見られた回数（見た場面の中で）', 'メモ'].map((x, i) => cell(x, W[i], true)) }),
          ...D.ch.map((c) => new TableRow({ cantSplit: true, children: [cell(`${c.tsutae}：${c.s}`, W[0]), cell('　　　回', W[1]), cell('', W[2])] })),
        ] });
        const box = (txt: string) => para('□　' + txt, { indent: { left: 200, hanging: 200 } });
        const lines = (n: number) => Array.from({ length: n }, () => new Paragraph({ spacing: { before: 280 }, border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: '999999', space: 1 } }, children: [] }));
        const doc = new Document({
          creator: 'toi toi toi', title: 'toi toi toi｜観察シート',
          sections: [{
            properties: { page: { size: { width: 11906, height: 16838 }, margin: { top: 850, bottom: 850, left: 850, right: 850, header: 400, footer: 400 } } },
            headers: { default: new Header({ children: [new Paragraph({ border: { bottom: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, children: [new TextRun({ text: 'toi toi toi｜支援の前に、立ち止まる　観察シート（同僚用）', font: FONT, size: 16, color: '555555' })] })] }) },
            footers: { default: new Footer({ children: [new Paragraph({ border: { top: { style: BorderStyle.SINGLE, size: 4, color: 'BBBBBB', space: 4 } }, children: [new TextRun({ text: '出典：toi toi toi https://toitoitoi-lab.github.io/tachidomaru/　このシートはサイトに送られません。名前は書きません。', font: FONT, size: 16, color: '555555' })] })] }) },
            children: [
              hd('観察シート（同僚に見てもらう）', HeadingLevel.HEADING_1),
              para('お願い：授業・活動を見て、あてはまるところに○や回数を書いてください（数分でかまいません）。子どもの名前や、だれか分かることは書きません。感想や評価ではなく、見たことだけを書きます。'),
              para('見てもらった日：　　　月　　　日　　　見る場面（例：1時間目の国語）：'),
              hd('1. 伝え方（見られた回数）', HeadingLevel.HEADING_2), table,
              hd('2. 予想外の反応があったとき', HeadingLevel.HEADING_2),
              para('見られたら、最初にした動きに○（複数可）。'),
              ...D.tf.map((x) => box(x.text)),
              para('その動きは、間に合っていたか？（1つ）'),
              ...D.tt.map((x) => box(x.text)),
              hd('3. ひとこと（見えたこと）', HeadingLevel.HEADING_2), ...lines(3),
            ],
          }],
        });
        const blob = await Packer.toBlob(doc);
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `toitoitoi_kansatsu_${file}.docx`; a.style.display = 'none';
        document.body.appendChild(a); a.click(); setTimeout(() => { a.remove(); URL.revokeObjectURL(a.href); }, 30000);
        note.textContent = '観察シート（Word）を保存しました。';
      } catch (e) { console.error(e); note.textContent = '観察シートを作れませんでした。'; }
    });
  </script>
