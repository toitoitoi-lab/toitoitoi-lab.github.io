        if (r.dot != null) { x.fillStyle = VI; x.beginPath(); x.arc(L + r.dot * len, y, 8, 0, 7); x.fill(); x.strokeStyle = '#fff'; x.lineWidth = 2; x.stroke(); }
        if (r.tag) { x.font = F(12, true); x.fillStyle = r.tag === '合っている' ? '#555' : VI; x.textAlign = 'right'; x.fillText(r.tag, W, y + 4); x.textAlign = 'left'; }
      });
      const png = new Promise<Uint8Array>((res) => cv.toBlob((bl) => bl!.arrayBuffer().then((ab) => res(new Uint8Array(ab))), 'image/png'));
      return { png, w: W, h: H };
    }

