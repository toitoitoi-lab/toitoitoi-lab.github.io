      const cv = document.createElement('canvas'); cv.width = W * S; cv.height = H * S; const x = cv.getContext('2d')!; x.scale(S, S);
      const F = (sz: number, b = false) => `${b ? '700 ' : ''}${sz}px "BIZ UDPGothic", "BIZ UDPゴシック", "Hiragino Sans", "Noto Sans JP", sans-serif`;
      x.fillStyle = '#fff'; x.fillRect(0, 0, W, H);
      const L = 128, R = W - 110, len = R - L, VI = '#4A33B0';
      // 凡例
      x.font = F(12); x.fillStyle = '#333'; let lx = 0;
      legend.forEach((t, i) => { const cx = lx + 8; if (i === 0) { x.fillStyle = VI; x.beginPath(); x.arc(cx, 10, 6, 0, 7); x.fill(); } else if (legend.length > 1 && rows.some((r) => r.band)) { x.strokeStyle = '#111'; x.lineWidth = 2; x.fillStyle = 'rgba(0,0,0,.12)'; x.beginPath(); x.roundRect(lx, 5, 22, 10, 5); x.fill(); x.stroke(); } else { x.strokeStyle = '#111'; x.lineWidth = 2.5; x.fillStyle = '#fff'; x.beginPath(); x.arc(cx, 10, 6, 0, 7); x.fill(); x.stroke(); } x.fillStyle = '#333'; x.fillText(t, lx + 28, 14); lx += 28 + x.measureText(t).width + 22; });
      x.fillStyle = '#555'; x.font = F(11); x.textAlign = 'left'; x.fillText('← ' + rows[0].left, L, 34); x.textAlign = 'right'; x.fillText(rows[0].right + ' →', R, 34); x.textAlign = 'left';
      rows.forEach((r, i) => {
        const y = TOP + i * RH + RH / 2;
        x.strokeStyle = '#ddd'; x.lineWidth = 1; x.beginPath(); x.moveTo(0, y - RH / 2); x.lineTo(W, y - RH / 2); x.stroke();
        x.font = F(13, true); x.fillStyle = '#111'; x.fillText(r.name, 0, y + 5);
        x.fillStyle = '#ccc'; x.fillRect(L, y - 2, len, 4); x.fillStyle = '#999'; x.fillRect(L + len / 2 - 1, y - 8, 2, 16);
        if (r.band) { const a = L + r.band[0] * len, b = L + r.band[1] * len, w = Math.max(b - a, 12), ax = b - a < 12 ? (a + b) / 2 - 6 : a; x.fillStyle = 'rgba(0,0,0,.12)'; x.strokeStyle = '#111'; x.lineWidth = 2.5; x.beginPath(); x.roundRect(ax, y - 7, w, 14, 7); x.fill(); x.stroke(); }
