---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import RulesNote from '../components/RulesNote.astro';
import { CHANNELS, AXES, SCALE_S, SCALE_C, REFRAME, TOSSA_FIRST, TOSSA_TIMING, TOSSA_PREP } from '../data/tachidomaru';
const title = '支援の前に、立ち止まる';
const desc = '子どもの「わかり方」と、あなたの「伝え方」を、ふだんの事実で見比べて、明日からの手立てと道具を考えるチェックです。診断ではありません。';
const json = JSON.stringify({ ch: CHANNELS, ax: AXES, sS: SCALE_S, sC: SCALE_C, tf: TOSSA_FIRST, tt: TOSSA_TIMING, tp: TOSSA_PREP });
const QB = (who: 's' | 'c') => AXES.map((a) => ({ id: `b${who}-${a.id}`, name: a.name, l: a[who].l, r: a[who].r }));
---
<Base title={title} lang="ja" current="tachiba" description={desc}>
  <div class="wrap page prose td">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: '立場から探す', href: '/#tachiba' }, { label: title }]} />
    <p class="kk-kicker" lang="en" aria-hidden="true">Before you support</p>
    <h1>{title}</h1>
    <p class="lead-text">チェックに答えると、<strong>その子の「わかり方」に合う伝え方</strong>と、<strong>明日からの手立て</strong>が出ます。子どもの「わかり方」と、あなたの「伝え方」を、ふだんの様子で見比べます。所要は5分ほどです。</p>
    <ul class="td-pts">
      <li><strong>診断ではありません。</strong>優劣もありません。見立てに自信がなくても、結果はそのまま明日の手立てになります。</li>
      <li><strong>答えは「意図」ではなく「事実」です。</strong>「どうしたいか」ではなく、「ふだん実際にしていること・見ている様子」を選びます。</li>
      <li><strong>名前は入れません。</strong>目の前の子どもの様子で答えます。答えや結果は、このサイトに送られず、保存もされません。</li>
    </ul>
    <RulesNote lang="ja" ctx="check" />

    <nav class="toc" aria-label="このページの目次"><ol>
      <li><a href="#q-s">1. あなた（支援する人）が、ふだんしていること</a></li>
      <li><a href="#q-t">2. 予想外の反応があったとき</a></li>
      <li><a href="#q-c">3. 子どものふだんの様子</a></li>
      <li><a href="#kekka">4. 結果：手立てを見る</a></li>
      <li><a href="#q-b">さらに：関わり方のくせ（任意）</a></li>
      <li><a href="#mado">くわしく知りたいとき（わかり方と伝え方・行動の裏側・観察シート）</a></li>
    </ol></nav>

    <h2 id="q-s">1. あなた（支援する人）が、ふだんしていること</h2>
    <p>先生・放課後等デイサービスの職員・家族など、支援する人が答えます。<strong>今週や最近の指導・支援を思い出しながら、ふだんの自分のやり方</strong>に近いものを選びます。「そうしたい」ではなく、「実際にしている」かどうかです。おおまかで構いません。</p>
    <div class="td-qs">
      {CHANNELS.map((c, i) => (
        <fieldset class="td-q">
          <legend><span class="td-n">{i + 1}</span><span class="td-tagm">{c.tsutae}</span>{c.s}</legend>
          <div class="opts td-opts">{SCALE_S.map((s, v) => <label><input type="radio" name={`s-${c.id}`} value={v} /><span>{s}</span></label>)}</div>
        </fieldset>
      ))}
    </div>

    <h2 id="q-t">2. 予想外の反応があったとき</h2>
    <p>授業や活動で、子どもが予想外の反応をしたときを思い出します（今週など、新しい記憶からで構いません）。<strong>実際にしたこと</strong>を選びます。答えなくても、結果は出ます。</p>
    <fieldset class="td-q">
      <legend><span class="td-n">a</span>そのとき、最初にしたことは？（あてはまるものすべて）</legend>
      <div class="opts td-opts td-opts-v">{TOSSA_FIRST.map((q) => <label><input type="checkbox" name="tt-first" value={q.id} /><span>{q.text}</span></label>)}</div>
    </fieldset>
    <fieldset class="td-q">
      <legend><span class="td-n">b</span>その動きは、間に合いましたか？（近いものを1つ）</legend>
      <div class="opts td-opts td-opts-v">{TOSSA_TIMING.map((q) => <label><input type="radio" name="tt-timing" value={q.id} /><span>{q.text}</span></label>)}</div>
    </fieldset>
    <p class="note">予想外は誰にでも起きます。差が出るのは、そのときの準備があるかどうかです。「間に合わなかった」も、そのまま選んで構いません。</p>

    <h2 id="q-c">3. 子どものふだんの様子</h2>
    <p><strong>ふだん見ている事実</strong>から答えます。本人が答えられるときは、一緒に答えても構いません。わかり方ごとに、「うまくいく場面」と「負担になる場面」を別々に答えます。両方あてはまることもあります。一人の子について、一回ずつ使います。</p>
    <div class="td-qs">
      {CHANNELS.map((c, i) => (
        <div class="td-qg">
          <p class="td-qgh"><span class="td-n">{i + 1}</span>{c.wakari}<span class="td-sub">（{c.sub}）</span></p>
          <fieldset class="td-q"><legend><span class="td-kind td-kind-s">うまくいく</span>{c.cS}</legend>
            <div class="opts td-opts">{SCALE_C.map((s, v) => <label><input type="radio" name={`cs-${c.id}`} value={v} /><span>{s}</span></label>)}</div></fieldset>
          <fieldset class="td-q"><legend><span class="td-kind td-kind-w">負担になる</span>{c.cW}</legend>
            <div class="opts td-opts">{SCALE_C.map((s, v) => <label><input type="radio" name={`cw-${c.id}`} value={v} /><span>{s}</span></label>)}</div></fieldset>
        </div>
      ))}
    </div>

    <h2 id="kekka">4. 結果：手立てを見る</h2>
    <p class="td-acts">
      <button type="button" class="btn btn-solid" id="td-go">結果を見る</button>
      <button type="button" class="btn" id="td-reset">最初からやり直す</button>
    </p>
    <p class="note" id="td-note" aria-live="polite"></p>
    <div id="td-out"></div>
    <div class="td-keep" id="td-keep" hidden>
      <h3>結果を残す（印刷・Word）</h3>
      <fieldset class="td-wfmt" id="td-wfmt">
        <legend>Wordの形式</legend>
        <div class="opts td-opts">
          <label><input type="radio" name="td-wf" value="zu" checked /><span>図と表で短く（A4 2枚まで）</span></label>
          <label><input type="radio" name="td-wf" value="moji" /><span>文字で短く（読み上げ向け・A4 2枚まで）</span></label>
        </div>
      </fieldset>
      <p class="td-acts">
        <button type="button" class="btn" id="td-word">Word形式で保存（編集できます）</button>
        <button type="button" class="btn" id="td-print">印刷する</button>
      </p>
      <p class="note td-save-note" id="td-save-note">印刷した紙や、保存したファイルは、あなたの手元（端末）に残ります。実名など、子どもが誰か分かることを書き足すときは、職場の個人情報のルールに従ってください。</p>
    </div>

    <h2 id="q-b">さらに：関わり方のくせ（任意）</h2>
    <details class="td-more">
      <summary>進め方・ペース・人との距離・変化の4つも答える</summary>
      <p>どちらの端も強みであり、場面によっては弱みになります。規律の教え方や、集団への入り方を考えるときに役立ちます。<strong>ふだんの様子で近いほう</strong>を1つ選びます（どちらも違うときは飛ばして構いません）。答えたら、もう一度「結果を見る」を押してください。</p>
      <h3>あなた</h3>
      <div class="td-qs">{QB('s').map((q) => <fieldset class="td-q"><legend><span class="td-tagm">{q.name}</span>近いほうを選ぶ</legend><div class="opts td-opts td-opts-v"><label><input type="radio" name={q.id} value="l" /><span>{q.l}</span></label><label><input type="radio" name={q.id} value="r" /><span>{q.r}</span></label></div></fieldset>)}</div>
      <h3>子ども</h3>
      <div class="td-qs">{QB('c').map((q) => <fieldset class="td-q"><legend><span class="td-tagm">{q.name}</span>近いほうを選ぶ</legend><div class="opts td-opts td-opts-v"><label><input type="radio" name={q.id} value="l" /><span>{q.l}</span></label><label><input type="radio" name={q.id} value="r" /><span>{q.r}</span></label></div></fieldset>)}</div>
    </details>

    <h2 id="mado">くわしく知りたいとき</h2>
    <details class="td-det td-det-lg" data-auto>
      <summary>「わかり方」と「伝え方」とは</summary>
      <p>子どもの<strong>わかり方</strong>は、その子がいちばん負担少なく、情報を受け取れる形です。大人の<strong>伝え方</strong>は、ふだん実際によくとっている、伝える形です。この2つが合うと伝わりやすく、ずれると、どちらも苦しくなります。<strong>手立て</strong>（写真カード・声がけ・タイマーなど）は、その場でとる行動や道具で、わかり方・伝え方とは別のものです。</p>
      <ul class="td-mado">
        {CHANNELS.map((c) => <li><strong>{c.wakari}</strong><span class="td-sub">（あなた：{c.tsutae}）</span></li>)}
      </ul>
    </details>
    <details class="td-det td-det-lg" data-auto>
      <summary>行動の裏側を見る（同じ行動が、強みでもあり弱みでもある）</summary>
      <p>目に見える行動は、「問題」と見える前に、その子の学び方のあらわれです。</p>
      <div class="td-tbl-wrap">
        <table class="td-tbl">
          <thead><tr><th scope="col">目に見える行動</th><th scope="col">強みとして見ると</th><th scope="col">学びで苦しくなる場面</th><th scope="col">関係するわかり方</th></tr></thead>
          <tbody>{REFRAME.map((r) => <tr><th scope="row">{r.act}</th><td>{r.tsuyomi}</td><td>{r.yowami}</td><td class="td-m">{r.mado}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
    <details class="td-det td-det-lg" data-auto>
      <summary>同僚に見てもらう（観察シート・A4 1枚）</summary>
      <p>自分の伝え方は、自分では見えにくいものです。授業のあと、同僚に5分で○を付けてもらう紙を作れます。<strong>サイトにも誰にも送りません。</strong>名前を書く欄はありません。自分の答えと、紙を見比べます。</p>
      <p class="td-acts"><button type="button" class="btn" id="td-obs">観察シートをWordで保存</button></p>
    </details>
    <details class="td-det td-det-lg" data-auto>
      <summary>使い方のヒント</summary>
      <ul>
        <li>「ずれ」は、あなたの弱い面ではなく、<strong>その伝え方が得意な人に相談するところ</strong>です。同僚・家族・放課後の支援者など、立場の違う人ほど、得意な伝え方も違います。</li>
        <li>「使いすぎ注意」は、あなたがよく使う伝え方です。よく使う分、つい使いすぎて、この子には負担になることがあります。</li>
        <li>手立ては1〜2週間試して、「うまくいっているサイン」が出なければ「効かなければ」へ進みます。子どもは変わります。学期ごと・担当が変わるたびに、やり直してください。</li>
      </ul>
    </details>
  </div>
  <script type="application/json" id="td-data" set:html={json}></script>
  <script>
    type Td = { first: string; sign: string; next: string };
    type Ch = { id: string; name: string; sub: string; wakari: string; tsutae: string; s: string; cS: string; cW: string; strong: { houhou: string[]; at: string[] }; weak: { houhou: string[]; at: string[] }; hyouri: string; soudan: string; tedate: { strong: Td; weak: Td; chui: string } };
    type Adv = { ikasu: string; ki: string; soudan: string };
    type Ax = { id: string; name: string; l: string; r: string; s: { l: string; r: string }; c: { l: string; r: string }; adv: Record<string, Adv> };
    const D = JSON.parse(document.getElementById('td-data')!.textContent!) as { ch: Ch[]; ax: Ax[]; sS: string[]; sC: string[]; tf: { id: string; text: string; ch: string }[]; tt: { id: string; text: string }[]; tp: Record<string, Td> };
    const $ = (id: string) => document.getElementById(id)!;
    const out = $('td-out'), note = $('td-note'), pr = $('td-print'), wd = $('td-word'), keep = $('td-keep');
    const showSave = (v: boolean) => { keep.hidden = !v; if (v) { const m = document.querySelector<HTMLInputElement>(`input[name="td-wf"][value="${document.documentElement.dataset.detail === 'open' ? 'moji' : 'zu'}"]`); if (m) m.checked = true; } };
    const val = (name: string): number | null => { const e = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`); return e ? Number(e.value) : null; };
    const h = (tag: string, cls?: string | null, text?: string | null) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const q = (names: string[]) => names.map((n) => `「${n}」`).join('');

    type Rel = 'kasanari' | 'zure' | 'chui' | 'ryouhou' | 'sonota';
    type ChRes = { c: Ch; s: number | null; cs: number | null; cw: number | null; sStrong: boolean | null; cStrong: boolean; cWeak: boolean; rel: Rel | null; relText: string; youSt: string; kidSt: string };
    function chResult(c: Ch): ChRes {
      const s = val('s-' + c.id), cs = val('cs-' + c.id), cw = val('cw-' + c.id);
      const sStrong = s === null ? null : s >= 2, cStrong = (cs ?? 0) >= 2, cWeak = (cw ?? 0) >= 2;
      let rel: Rel | null = null, relText = '';
      const wk = `「${c.wakari}」`, ts = `「${c.tsutae}」`;
      if (sStrong !== null && (cStrong || cWeak)) {
        if (sStrong && cStrong && !cWeak) { rel = 'kasanari'; relText = `合っている：この子は${wk}場面でうまくいきます。あなたは、ふだん${ts}をよく使っています。そのまま入口に使えます。同じ伝え方ばかりにならないよう、ほかの伝え方も一つ添えます。`; }
        else if (!sStrong && cStrong && !cWeak) { rel = 'zure'; relText = `ずれ：この子は${wk}場面でうまくいきますが、あなたは${ts}をあまり使っていません。下の方法や道具で補うか、${c.soudan}に、やり方を見せてもらいます。`; }
        else if (sStrong && cWeak) { rel = 'chui'; relText = `使いすぎ注意：あなたがよく使う${ts}は、この子には負担になりやすい伝え方${cStrong ? 'でもあります' : 'です'}。量を減らし、この子の「わかり方」に合う伝え方に置きかえます。`; }
        else if (!sStrong && cWeak) { rel = 'ryouhou'; relText = `どちらも負担：${ts}は、あなたもあまり使わず、この子にも負担になりやすい伝え方です。無理に使わず、道具（AT）や、${c.soudan}の力を借ります。`; }
      } else if (sStrong !== null) { rel = 'sonota'; relText = sStrong ? `あなたがよく使う${ts}です。この子は、このわかり方では、目立った「うまくいく」「負担になる」がありません。` : 'この子は、このわかり方では、目立った「うまくいく」「負担になる」がありません。'; }
      const youSt = s === null ? '未回答' : sStrong ? 'よく使う' : 'あまり使わない';
      const kidSt = cs === null && cw === null ? '未回答' : cStrong && cWeak ? 'うまくいく場面と負担の両方' : cStrong ? 'うまくいく' : cWeak ? '負担になる' : 'どちらも目立たない';
      return { c, s, cs, cw, sStrong, cStrong, cWeak, rel, relText, youSt, kidSt };
    }
    const REL_LABEL: Record<Rel, string> = { kasanari: '合っている', zure: 'ずれ', chui: '使いすぎ注意', ryouhou: 'どちらも負担', sonota: '' };

    // 第2部（2択）：左・右のどちらに近いか
    type AxRes = { a: Ax; s: 'l' | 'r' | null; c: 'l' | 'r' | null; st: string; adv: Adv | null; partial: string };
    function axResult(a: Ax): AxRes | null {
      const pick = (who: string) => { const e = document.querySelector<HTMLInputElement>(`input[name="b${who}-${a.id}"]:checked`); return e ? (e.value as 'l' | 'r') : null; };
      const s = pick('s'), c = pick('c'); if (!s && !c) return null;
      const st = s && c ? (s === c ? '合っている' : 'ずれ') : '';
      const key = s && c ? s + c : s ? s + s : c ? c + c : null;
      const partial = key && (!s || !c) ? `${s ? '子ども' : 'あなた'}は、この軸では答えていません。答えたほうに合わせた文です。` : '';
      return { a, s, c, st, adv: key ? a.adv[key] : null, partial };
    }

    // 予想外のとき：最初にとった動き（事実）と、間に合ったか
    type Tossa = { used: Ch[]; rel: 'ok' | 'zure' | 'none'; text: string; timing: string; timeText: string; ent: Ch | null };
    function tossaResult(R: ChRes[]): Tossa | null {
      const ids = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="tt-first"]:checked')).map((e) => e.value);
      const tm = document.querySelector<HTMLInputElement>('input[name="tt-timing"]:checked')?.value || '';
      if (!ids.length && !tm) return null;
      const chs = Array.from(new Set(ids.map((id) => D.tf.find((x) => x.id === id)!.ch)));
      const used = chs.map((id) => D.ch.find((c) => c.id === id)!);
      const entR = R.find((r) => r.cStrong && !r.cWeak) || R.find((r) => r.cStrong), ent = entR ? entR.c : null;
      const isW = (c: Ch) => R.some((r) => r.c.id === c.id && r.cWeak), isE = (c: Ch) => R.some((r) => r.c.id === c.id && r.cStrong && !r.cWeak);
      const clash = used.filter(isW), okc = used.filter(isE);
      const names = (l: Ch[]) => q(l.map((c) => c.tsutae));
      let rel: Tossa['rel'] = 'none', text = '';
      if (used.length) {
        if (clash.length) { rel = 'zure'; text = `とっさの一手が、この子の負担になる伝え方とずれています。あなたはとっさに${names(clash)}を使いました。${ent ? `次にとっさのときは、この子の「${ent.wakari}」に合わせて、「${ent.tsutae}」に替えます。` : '次は、いちばん負担の少ない伝え方を探します。'}`; }
        else if (okc.length) { rel = 'ok'; text = `とっさの一手が、この子のわかり方と合っています。${names(okc)}を続けます。`; }
        else if (ent) { rel = 'zure'; text = `とっさの一手が、この子の入口とずれています。あなたは${names(used)}を使いました。この子は「${ent.wakari}」場面でうまくいきます。次は「${ent.tsutae}」を先に試します。`; }
        else { text = `とっさの一手（${names(used)}）を選びました。この子の入口がまだはっきりしないので、まず「うまくいく場面」を探します。`; }
      }
      const timeText = tm === 'sign' ? '崩れる前のサインで動けています。' : tm === 'after' ? '崩れてから動いています。崩れる前のサインを決めておくと、間に合いやすくなります。' : tm === 'late' ? '活動が終わってから気づいています。まず、どこで反応が変わったかを書き留めます。' : '';
      return { used, rel, text, timing: tm, timeText, ent };
    }

    let last: { ch: ChRes[]; ax: AxRes[]; sum: string[]; te: Te[]; ts: Tossa | null } | null = null;

    // 結論：入口／負担／あなたの動き（／予想外のとき）
    function summary(R: ChRes[], T: Tossa | null) {
      const pick = (f: (r: ChRes) => boolean, k: 'wakari' | 'tsutae') => R.filter(f).map((r) => r.c[k]);
      const ent = pick((r) => r.cStrong, 'wakari'), hv = pick((r) => r.cWeak, 'wakari');
      const chui = pick((r) => r.rel === 'chui', 'tsutae'), zure = pick((r) => r.rel === 'zure', 'wakari'), both = pick((r) => r.rel === 'ryouhou', 'tsutae');
      const L: string[] = [];
      L.push(ent.length ? `この子がうまくいく入口は${q(ent)}。ここから始めます。` : '入口になるわかり方は、まだはっきりしません。下の手立てを試しながら探します。');
      L.push(hv.length ? `負担が大きいのは${q(hv)}。量を減らすか、入口の伝え方に置きかえます。` : '負担の大きいわかり方は、目立ちません。');
      if (chui.length) L.push(`あなたがよく使う${q(chui)}は、この子には負担になりやすい伝え方です。控えめにします。`);
      else if (zure.length) L.push(`この子の入口${q(zure)}は、あなたがあまり使わない伝え方です。得意な人に、やり方を見せてもらいます。`);
      else if (both.length) L.push(`${q(both)}は、あなたにも、この子にも負担です。道具と、得意な人の力を借ります。`);
      else L.push('あなたがふだん使う伝え方で、この子に届きます。');
      if (T && T.text) L.push(T.text);
      if (T && T.timeText) L.push(T.timeText);
      return L;
    }
    // 明日からの手立て：見立てに自信がなくても、そのままやれる順に並べる（あなたが変えること → 入口 → 負担を減らす）
    type Te = { win: string; kind: string; first: string; sign: string; next: string; at: string[] };
    function tedate(R: ChRes[], T: Tossa | null): Te[] {
      const out: Te[] = [];
      if (T && T.rel === 'zure' && T.ent) {
