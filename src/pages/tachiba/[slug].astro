---
import TachibaPage from '../../components/TachibaPage.astro';
import TsukuruPage from '../../components/TsukuruPage.astro';
import { TACHIBA } from '../../data/site';
export function getStaticPaths() {
  return TACHIBA.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
---
{t.slug === 'tsukuru' ? <TsukuruPage t={t} lang="ja" /> : <TachibaPage t={t} lang="ja" />}
