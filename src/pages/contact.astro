---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base title="お問い合わせ" lang="ja" current="contact">
  <div class="wrap page prose contact-page">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: 'お問い合わせ' }]} />
    <h1>お問い合わせ</h1>
    <p class="lead-text">困りごとの相談、研修のご依頼、記事や教材を使いたいときの事前連絡、サイトへのご意見を受けつけています。「こんなことを聞いてもいいのかな」ということも、どうぞ気軽に。</p>
    <ContactForm lang="ja" />
  </div>
</Base>
