---
import Base from '../../layouts/Base.astro';
import Illust from '../../components/Illust.astro';
import Soon from '../../components/Soon.astro';
import Crumbs from '../../components/Crumbs.astro';
import MethodSearch from '../../components/MethodSearch.astro';
import { KOMARI, TACHIBA } from '../../data/site';
import { CONTENT, CHECKED, KIND_LABEL } from '../../data/methods';
export function getStaticPaths() {
  return KOMARI.map((k) => ({ params: { slug: k.slug }, props: { k } }));
}
const { k } = Astro.props;
const c = CONTENT[k.slug];
const kinds = (['os', 'tool', 'env'] as const).filter((kd) => c?.methods.some((m) => m.kind === kd));
const t = Object.fromEntries(TACHIBA.map((x) => [x.slug, x]));
const others = KOMARI.filter((o) => o.slug !== k.slug);
---
<Base title={k.ja.title} current="komari" description={`${k.ja.title}の困りごとに合う道具（AT）と使い方：${k.ja.examples}`}>
  <div class="wrap page komari-page">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: '困りごとから探す', href: '/#komari' }, { label: k.ja.title }]} />
    <div class="page-head">
      <div class={`art-sm stage-${k.stage}`}><Illust shapes={k.shapes} /></div>
      <div>
        <h1>{k.ja.title}</h1>
        {!k.ready && <Soon label={k.review ? '確認中' : undefined} />}
      </div>
    </div>

    {!c ? (
      <div class="notice"><p><strong>このページは準備中です。</strong></p></div>
    ) : (
      <>
        <p class="lead-text">{c.lead}</p>
        {k.review && (
          <div class="notice">
            <p><strong>この内容は下書きです（確認中）。</strong>一般的な方法をまとめています。合う方法は一人ひとり違うので、試しながら選んでください。</p>
            <p>機能の名前や場所は、機種やバージョンによって違うことがあります（{CHECKED}時点）。</p>
          </div>
        )}

        <MethodSearch slug={k.slug} />

        <nav class="toc" aria-label="このページの目次">
          <h2 class="toc-title">方法の一覧</h2>
          <ul>
            {kinds.map((kd) => (
              <li>
                <a href={`#kind-${kd}`}>{KIND_LABEL[kd]}</a>
                <ul>{c.methods.filter((m) => m.kind === kd).map((m) => <li><a href={`#m-${m.id}`}>{m.title}</a></li>)}</ul>
              </li>
            ))}
            <li><a href="#points">立場ごとのポイント</a></li>
          </ul>
        </nav>

        {kinds.map((kd) => (
          <section class="kind" aria-labelledby={`kind-${kd}`}>
            <h2 id={`kind-${kd}`}>{KIND_LABEL[kd]}</h2>
            {c.methods.filter((m) => m.kind === kd).map((m) => (
              <article class="method" id={`m-${m.id}`} aria-labelledby={`mt-${m.id}`}>
                <h3 id={`mt-${m.id}`}>{m.title}</h3>
                <p>{m.summary}</p>
                {m.devices && (
                  <dl class="devices">
                    {m.devices.map((d) => (<div><dt>{d.name}</dt><dd>{d.how}</dd></div>))}
                  </dl>
                )}
                {m.tips && <ul class="tips">{m.tips.map((tip) => <li>{tip}</li>)}</ul>}
                <p class="fits"><span>こんなときに：</span>{m.situations.map((sid) => c.situations.find((s) => s.id === sid)?.label).filter(Boolean).join('／')}</p>
              </article>
            ))}
          </section>
        ))}

        <section id="points" aria-labelledby="points-title">
          <h2 id="points-title">立場ごとのポイント</h2>
          <ul class="points">
            {(['sensei', 'honnin', 'tsukuru'] as const).map((key) => (
              <li>
                <div class={`art-xs stage-${t[key].stage}`}><Illust shapes={t[key].shapes} /></div>
                <div><h3>{t[key].ja.title}</h3><p>{c.points[key]}</p></div>
              </li>
            ))}
          </ul>
        </section>

        {c.links && (
          <section aria-labelledby="links-title">
            <h2 id="links-title">参考になるページ</h2>
            <ul>{c.links.map((l) => <li><a class="inline" href={l.href}>{l.label}（外部サイト）</a></li>)}</ul>
          </section>
        )}
      </>
    )}

    <section aria-labelledby="others-title">
      <h2 id="others-title">ほかの困りごと</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={`/komari/${o.slug}/`}><span class={`art-xs stage-${o.stage}`}><Illust shapes={o.shapes} /></span>{o.ja.title}</a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
