---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Kokoroe from '../../components/Kokoroe.astro';
import { KOKOROE } from '../../data/message';
const K = KOKOROE.en;
---
<Base title={K.heading} lang="en" current="komari" description={K.lead}>
  <div class="wrap page prose hitokufu">
    <Crumbs lang="en" items={[{ label: 'Home', href: '/en/' }, { label: K.heading }]} />
    <p class="kk-kicker" lang="en" aria-hidden="true">{K.kicker}</p>
    <h1>{K.heading}</h1>
    <Kokoroe lang="en" />
  </div>
</Base>
