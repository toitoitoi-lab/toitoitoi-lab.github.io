---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { UPDATES } from '../../data/updates';
const label = (d: string) => { const [y, m, dd] = d.split('-').map(Number); return new Date(Date.UTC(y, m - 1, dd)).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }); };
---
<Base lang="en" title="Updates" description="What has changed on toi toi toi, newest first.">
  <div class="wrap page prose">
    <Crumbs lang="en" items={[{ label: 'Home', href: '/en/' }, { label: 'Updates' }]} />
    <h1>Updates</h1>
    <p>Newest first.</p>
    <ul class="nw-list nw-hist">
      {UPDATES.map((u) => (
        <li><time datetime={u.date}>{label(u.date)}</time><span class="nw-t">{u.en}</span>{u.href && <a href={u.jaOnly ? u.href : '/en' + u.href}>Details</a>}</li>
      ))}
    </ul>
  </div>
</Base>
