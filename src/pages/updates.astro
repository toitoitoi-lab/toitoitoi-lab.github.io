---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import UpdatesHistory from '../components/UpdatesHistory.astro';
---
<Base title="更新履歴" description="toi toi toi lab の更新履歴です。新しいものから順に並んでいます。">
  <div class="wrap page prose">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: '更新履歴' }]} />
    <h1>更新履歴</h1>
    <p>新しいものから順に並んでいます。月ごとにまとめ、見出しを押すと中身がひらきます。</p>
    <UpdatesHistory lang="ja" />
  </div>
</Base>
