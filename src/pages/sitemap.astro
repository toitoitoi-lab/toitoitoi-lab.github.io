---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Soon from '../components/Soon.astro';
import Illust from '../components/Illust.astro';
import { SITEMAP_JA } from '../data/site';
const total = SITEMAP_JA.reduce((n, g) => n + g.links.length, 0);
const icons: Record<string, string> = {
  home: 'M3 11 12 4l9 7M5 10v10h14V10M10 20v-6h4v6',
  komari: 'M9 9a3 3 0 1 1 4.5 2.6c-1 .6-1.5 1.2-1.5 2.4M12 17.5v.5M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
  tachiba: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6M17 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM15 14.5c.6-.3 1.3-.5 2-.5 2.6 0 4.5 2.2 4.5 5.5',
  hasshin: 'M3 10v4h3l6 4V6l-6 4H3zM16 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12',
};
---
<Base title="サイトマップ" current="sitemap">
  <div class="wrap page sitemap-page">
    <Crumbs items={[{ label: 'トップ', href: '/' }, { label: 'サイトマップ' }]} />
    <h1>サイトマップ</h1>
    <p>このサイトのページは、<strong>4つのまとまり</strong>に分かれています（全{total}ページ）。まとまりの名前の下に、その中のページが並んでいます。</p>

    <nav class="map-overview" aria-label="まとまりへ移動">
      <ol>
        {SITEMAP_JA.map((g, i) => (
          <li><a href={`#${g.id}`}><span class="num" aria-hidden="true">{i + 1}</span>{g.heading}<span class="count">{g.links.length}ページ</span></a></li>
        ))}
      </ol>
    </nav>

    <ol class="tree">
      {SITEMAP_JA.map((g, i) => (
        <li class="tree-group" id={g.id}>
          <div class="group-head">
            <span class="group-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[g.icon]}></path></svg>
            </span>
            <div>
              <h2><span class="num" aria-hidden="true">{i + 1}</span>{g.heading}</h2>
              <p class="group-desc">{g.desc}<span class="count">（{g.links.length}ページ）</span></p>
            </div>
          </div>
          <ul class="tree-children" aria-label={`${g.heading}の中のページ`}>
            {g.links.map((l) => (
              <li>
                <a class="child" href={l.href}>
                  {l.shapes
                    ? <span class={`thumb stage-${l.stage}`}><Illust shapes={l.shapes} /></span>
                    : <span class="thumb thumb-plain" aria-hidden="true"></span>}
                  <span class="child-text">
                    <span class="child-label">{l.label}{l.external && <span class="visually-hidden">（外部サイト）</span>}</span>
                    {l.note && <span class="child-note" aria-hidden={l.external ? 'true' : undefined}>{l.note}</span>}
                  </span>
                </a>
                {!l.ready && <Soon label={l.review ? '確認中' : undefined} />}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</Base>
